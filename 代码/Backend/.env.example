# AI replay service
AI_REPLAY_PORT=8002
AI_REPLAY_DEBUG=false
AI_REPLAY_SERVICE_BASE_URL=http://127.0.0.1:8002

# Replay trigger
AUTO_TRIGGER_REPLAY_ANALYSIS=false
REPLAY_ENABLE_AI=true
REPLAY_OUTPUT_DIR=replay_analysis

# Model provider
# Replace this with your real Zhipu API key.
REPLAY_AI_API_KEY=your_zhipu_api_key_here
REPLAY_AI_MODEL=glm-4-air
REPLAY_AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# Compatibility fallback for code paths that still read OPENAI_API_KEY
OPENAI_API_KEY=
