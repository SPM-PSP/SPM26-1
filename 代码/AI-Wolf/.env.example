# 狼人杀游戏配置文件示例
# 复制此文件为 .env 并填入你的实际配置

# ==================== API 配置 ====================

# ==================== 模型选择 ====================
# 可选值: dashscope, openai, ollama
# 选择 openai 可单独为玩家单独配置模型
MODEL_PROVIDER=dashscope


# 1、DashScope API Key (阿里云通义千问)
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_MODEL_NAME=qwen2.5-32b-instruct

# Zhipu OpenAI-compatible API
# To enable it, set MODEL_PROVIDER=zhipu
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_MODEL_NAME=glm-4.5-air


# 2、Ollama 配置 (本地模型)
OLLAMA_MODEL_NAME=qwen2.5:1.5b

LOCAL_HF_MODEL_NAME=Qwen3-0.6B-Base
LOCAL_HF_MODEL_PATH=models/Qwen3-0.6B-Base
# auto: prefer CUDA when a GPU is available; use cuda or cuda:0 to pin a single GPU
LOCAL_HF_DEVICE=auto
LOCAL_HF_DTYPE=auto
LOCAL_HF_QUANTIZATION=4bit
LOCAL_HF_QUANT_TYPE=nf4
LOCAL_HF_QUANT_COMPUTE_DTYPE=float16
LOCAL_HF_USE_DOUBLE_QUANT=true
LOCAL_HF_TRUST_REMOTE_CODE=false


# 3、OpenAI 兼容 API 配置
# 玩家配置模式: 
# single: 共用一个模型  per-player: 每个玩家单独配置模型
OPENAI_PLAYER_MODE=single

# 共用模型配置 
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL_NAME=qwen3.6-flash


# ... 依次到 P9，若不填则系统自动使用上面的全局配置
# Player1 模型配置
OPENAI_API_KEY_P1=your_api_key_here
OPENAI_BASE_URL_P1=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL_NAME_P1=deepseek-v4-pro
# Player2 模型配置
OPENAI_API_KEY_P2=your_api_key_here
OPENAI_BASE_URL_P2=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL_NAME_P2=qwen3.6-flash

# Player3 模型配置
OPENAI_API_KEY_P3=your_openai_api_key_here
OPENAI_BASE_URL_P3=your_openai_base_url_here
OPENAI_MODEL_NAME_P3=your_openai_model_name_here

# Player4 模型配置
OPENAI_API_KEY_P4=your_openai_api_key_here
OPENAI_BASE_URL_P4=your_openai_base_url_here
OPENAI_MODEL_NAME_P4=your_openai_model_name_here

# Player5 模型配置
OPENAI_API_KEY_P5=your_openai_api_key_here
OPENAI_BASE_URL_P5=your_openai_base_url_here
OPENAI_MODEL_NAME_P5=your_openai_model_name_here

# Player6 模型配置
OPENAI_API_KEY_P6=your_openai_api_key_here
OPENAI_BASE_URL_P6=your_openai_base_url_here
OPENAI_MODEL_NAME_P6=your_openai_model_name_here

# Player7 模型配置
OPENAI_API_KEY_P7=your_openai_api_key_here
OPENAI_BASE_URL_P7=your_openai_base_url_here
OPENAI_MODEL_NAME_P7=your_openai_model_name_here

# Player8 模型配置
OPENAI_API_KEY_P8=your_openai_api_key_here
OPENAI_BASE_URL_P8=your_openai_base_url_here
OPENAI_MODEL_NAME_P8=your_openai_model_name_here

# Player9 模型配置
OPENAI_API_KEY_P9=your_openai_api_key_here
OPENAI_BASE_URL_P9=your_openai_base_url_here
OPENAI_MODEL_NAME_P9=your_openai_model_name_here





