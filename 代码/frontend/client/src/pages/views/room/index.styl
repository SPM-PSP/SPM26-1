.room-container
  width 100%
  height 100%
  background-color #ffffff
  position relative
  .title-text
    width 100%
    font-size 16px
    font-weight bold
    text-align center
  .full-btn
    width 100%
  .room-wrap
    position relative
    width 100%
    height 100vh
    overflow hidden
    .btn-record
      position fixed
      bottom 80px
      font-size 14px
      font-weight bold
      height 80px
      width 80px
      border-radius 40px
      text-align center
      line-height 80px
      cursor pointer
      left calc(50% + 150px)
    .btn-refresh
      position fixed
      bottom 80px
      font-size 14px
      font-weight bold
      height 80px
      width 80px
      border-radius 40px
      text-align center
      line-height 80px
      cursor pointer
      left 50%
      transform translateX(-50%)
    .btn-next-stage
      position fixed
      bottom 80px
      font-size 14px
      font-weight bold
      height 80px
      width 80px
      border-radius 40px
      text-align center
      line-height 80px
      cursor pointer
      left calc(50% - 230px)
.error-view
  width 100%
  .desc
    font-size 16px
    font-weight 500
    text-align center
.player-click-modal
  .content-wrap
    width 100%
    .content-view
      border-radius 4px
      border 1px solid #eeeeee
      overflow scroll
      height 300px
      position relative
      margin-left 20px
      margin-right 20px
      padding 10px
      flex-wrap wrap
      flex-direction row
      justify-content space-around
      display flex
      .player-cell
        width 120px
        height 70px
        margin 10px
        border-radius 2px
        position relative
        .camp-tag
          height 20px
          position absolute
          border-radius 10px
          right 4px
          top 4px
          padding-left 10px
          padding-right 10px
          line-height 20px
          text-align center
          font-weight 500
          color #ffffff
      .check-item
        background-color #b8f1ed
      .normal-item
        border 1px solid #eeeeee
      .target-item
        background-color #d4237a
      .txt
        font-weight 500
      .check-text
        color #ffffff
      .normal-text
        color black
    .result-view
      .tit
        font-size 14px
        line-height 20px
        font-weight 500
        text-align center
        width 100%
      .content
        width auto
        font-size 14px
    .prompt-view
      font-size 14px
      color orange
      font-style italic
      font-weight 500
.role-card-wrap
  .card-img
    width 100%
    height auto
.ant-modal-confirm-content
  margin-left 0!important

.winner-wrap
  width 100%
  .img-card-wrap
    position relative
    img
      width 80%
      height auto
    .winner-mask
      position absolute
      width 80%
      height 100%
      left 10%
      top 0
      background-color black
      opacity 0.5
    .winner-mask-text-wrap
      position absolute
      width 80%
      height 100%
      left 10%
      top 0
      img
        width 64px
        height 64px
      .txt
        text-align center
        color #ffffff
        font-weight bold
        font-size 20px
        line-height 100%

.winner-title
  font-size 18px

.room-ready-shell
  --surface #fef9eb
  --surface-low #f8f3e5
  --surface-mid #f3eee0
  --surface-high #e7e2d4
  --primary #63000a
  --primary-dark #410004
  --secondary #546432
  --secondary-soft #d7eaab
  --tertiary #482400
  --tertiary-soft #ffdcc3
  width 100%
  height 100vh
  min-height 680px
  display grid
  grid-template-columns 256px minmax(720px, 1fr) 340px
  grid-template-rows 76px minmax(0, 1fr)
  position relative
  overflow-x auto
  overflow-y hidden
  color #1d1c13
  background var(--surface)
  font-family Georgia, 'Noto Serif SC', 'Noto Serif', serif

.ready-bg
  position fixed
  inset 76px 340px 0 256px
  z-index 0
  pointer-events none
  background var(--surface-low)
  overflow hidden

.ready-bg img
  width 100%
  height 100%
  object-fit cover
  opacity .3
  filter sepia(.08) saturate(.85)

.ready-bg:after
  content ''
  position absolute
  inset 0
  background linear-gradient(0deg, rgba(254,249,235,.88), rgba(254,249,235,.42) 34%, rgba(254,249,235,.18) 68%, rgba(254,249,235,.72))

.ready-topbar
  grid-column 1 / 4
  grid-row 1
  z-index 5
  position relative
  display flex
  align-items center
  justify-content space-between
  padding 0 30px
  background linear-gradient(180deg, rgba(231,226,212,.82), rgba(254,249,235,.88))
  box-shadow 0 10px 30px -18px rgba(29,28,19,.28)

.ready-brand
  color #2d4b22
  font-size 26px
  font-weight 900
  font-style italic

.ready-topbar nav
  display flex
  gap 30px
  margin-left 28px
  margin-right auto

.ready-topbar button
  border 0
  background transparent
  color var(--secondary)
  cursor pointer
  font-family inherit
  font-size 16px
  font-weight 900
  font-style italic

.ready-room-plaque
  position absolute
  left 50%
  bottom -18px
  transform translateX(-50%)
  min-width 150px
  padding 9px 22px 12px
  border-radius 8px
  border-bottom 4px solid #2f1500
  display flex
  flex-direction column
  align-items center
  background var(--tertiary)
  box-shadow 0 12px 24px rgba(29,28,19,.22)

.ready-room-plaque span
  color var(--tertiary-soft)
  font-size 10px
  font-weight 900

.ready-room-plaque strong
  color #fff
  font-size 22px
  line-height 1.1

.ready-top-actions
  display flex
  gap 12px

.ready-top-actions button
  color var(--primary)
  font-size 22px

.ready-sidebar
  grid-column 1
  grid-row 2
  z-index 3
  min-height 0
  padding 26px 30px 24px
  display flex
  flex-direction column
  gap 24px
  background var(--surface-low)
  border-radius 0 30px 0 0
  box-shadow 22px 0 42px rgba(29,28,19,.08)

.ready-narrator
  display flex
  align-items center
  gap 14px

.ready-narrator img
  width 56px
  height 56px
  border-radius 50%
  border 2px solid var(--primary)
  object-fit cover

.ready-narrator strong
  display block
  color var(--primary)
  font-size 18px

.ready-narrator span
  display block
  color var(--secondary)
  font-size 12px
  line-height 1.4

.ready-sidebar nav
  display flex
  flex-direction column
  gap 10px

.ready-sidebar nav button,
.ready-side-link
  min-height 44px
  border 0
  border-radius 12px
  display flex
  align-items center
  gap 14px
  padding 0 12px
  color rgba(90,106,55,.76)
  background transparent
  cursor pointer
  font-family inherit
  font-size 14px
  font-weight 800
  text-align left

.ready-sidebar nav button.active,
.ready-sidebar nav button:hover,
.ready-side-link:hover
  color var(--primary)
  background rgba(231,226,212,.72)

.ready-summary
  display grid
  gap 10px
  padding 16px
  border-radius 14px
  background rgba(254,249,235,.74)
  border 1px solid rgba(231,226,212,.8)

.ready-summary div
  display flex
  align-items center
  justify-content space-between
  color #43483f
  font-size 12px

.ready-summary strong
  color var(--primary)
  font-size 15px

.ready-start-btn
  min-height 58px
  border 0
  border-radius 14px
  color #fff
  background linear-gradient(135deg, var(--primary), #85171b)
  box-shadow 0 16px 26px rgba(99,0,10,.2)
  font-family inherit
  font-size 18px
  font-weight 900
  cursor pointer

.ready-start-btn:disabled
  opacity .48
  cursor not-allowed

.ready-side-link
  margin-top auto

.ready-main
  grid-column 2
  grid-row 2
  z-index 2
  min-width 0
  min-height 0
  overflow-y auto
  padding 22px 30px 18px

.ready-square-card
  position relative
  min-height 0
  height 100%
  display flex
  flex-direction column
  align-items center
  justify-content space-between

.ready-status-banner
  min-width 390px
  padding 12px 44px
  border 3px solid var(--secondary)
  border-radius 999px
  background rgba(215,234,171,.92)
  text-align center
  box-shadow 0 18px 36px rgba(29,28,19,.12)

.ready-status-banner h2
  margin 0
  color var(--secondary)
  font-size 30px
  line-height 1.1
  font-weight 900
  letter-spacing .16em

.ready-status-banner p
  margin 6px 0 0
  color #3d4c1d
  font-size 13px

.ready-orbit
  position relative
  width min(920px, 100%)
  flex 1
  min-height 480px
  margin 10px 0 8px
  display grid
  grid-template-columns repeat(5, 1fr)
  grid-template-rows repeat(3, 1fr)
  gap 28px 16px
  align-items center
  justify-items center

.ready-seat-card
  position relative
  transform none
  width 112px
  border 0
  background transparent
  display flex
  flex-direction column
  align-items center
  cursor pointer
  font-family inherit

.ready-seat-slot
  position static
  display flex
  align-items center
  justify-content center
  min-width 0
  min-height 0

.ready-seat-slot-1
  grid-column 1
  grid-row 1

.ready-seat-slot-2
  grid-column 2
  grid-row 1

.ready-seat-slot-3
  grid-column 3
  grid-row 1

.ready-seat-slot-4
  grid-column 4
  grid-row 1

.ready-seat-slot-5
  grid-column 5
  grid-row 1

.ready-seat-slot-6
  grid-column 1
  grid-row 2

.ready-seat-slot-7
  grid-column 5
  grid-row 2

.ready-seat-slot-8
  grid-column 1
  grid-row 3

.ready-seat-slot-9
  grid-column 2
  grid-row 3

.ready-seat-slot-10
  grid-column 3
  grid-row 3

.ready-seat-slot-11
  grid-column 4
  grid-row 3

.ready-seat-slot-12
  grid-column 5
  grid-row 3

.ready-seat-slot-1 .ready-seat-frame,
.ready-seat-slot-5 .ready-seat-frame,
.ready-seat-slot-10 .ready-seat-frame
  transform rotate(-4deg)

.ready-seat-slot-2 .ready-seat-frame,
.ready-seat-slot-8 .ready-seat-frame,
.ready-seat-slot-12 .ready-seat-frame
  transform rotate(3deg)

.ready-seat-slot-3 .ready-seat-frame,
.ready-seat-slot-6 .ready-seat-frame,
.ready-seat-slot-11 .ready-seat-frame
  transform rotate(2deg)

.ready-seat-slot-4 .ready-seat-frame,
.ready-seat-slot-7 .ready-seat-frame,
.ready-seat-slot-9 .ready-seat-frame
  transform rotate(-2deg)

.ready-seat-frame
  position relative
  width 82px
  height 82px
  padding 7px
  border-radius 12px
  background var(--tertiary)
  border-bottom 5px solid #2f1500
  box-shadow 0 18px 32px rgba(47,21,0,.24)
  transform rotate(-4deg)
  transition transform .2s ease

.ready-seat-card:hover .ready-seat-frame
  transform scale(1.05) rotate(0deg)

.ready-seat-frame img,
.ready-seat-placeholder
  width 100%
  height 100%
  border 2px solid var(--tertiary-soft)
  border-radius 7px
  object-fit cover
  background #fff

.ready-seat-placeholder
  display flex
  align-items center
  justify-content center
  color rgba(72,36,0,.42)
  background rgba(254,249,235,.84)
  font-size 28px

.ready-seat-number
  position absolute
  left 50%
  top -11px
  transform translateX(-50%)
  min-width 42px
  padding 2px 8px
  border-radius 999px
  color #fff
  background var(--primary)
  font-size 11px
  font-weight 900

.ready-seat-name
  margin-top 7px
  max-width 130px
  padding 3px 10px
  border-radius 4px
  color #fff
  background var(--primary)
  font-size 12px
  line-height 1.3
  font-weight 900
  white-space nowrap
  overflow hidden
  text-overflow ellipsis

.ready-seat-note
  margin-top 4px
  color var(--secondary)
  font-size 11px
  font-weight 800

.ready-seat-empty .ready-seat-frame
  background rgba(72,36,0,.46)
  border-bottom-color rgba(47,21,0,.58)

.ready-seat-empty .ready-seat-name
  color var(--primary)
  background var(--tertiary-soft)

.ready-seat-reserve
  opacity .74

.ready-seat-kick .ready-seat-frame
  background #85171b
  border-bottom-color var(--primary-dark)

.ready-day-player
  cursor default

.ready-day-player.day-player-self .ready-seat-frame
  background #85171b
  border-bottom-color var(--primary-dark)

.ready-day-player.day-player-dead
  opacity .72

.ready-day-player.day-player-dead .ready-seat-frame img
  filter grayscale(1)
  opacity .52

.ready-day-player.day-player-dead .ready-seat-frame:after
  content '出局'
  position absolute
  inset 7px
  border-radius 7px
  display flex
  align-items center
  justify-content center
  color #fff
  background rgba(65,0,4,.62)
  font-size 16px
  font-weight 900

.day-player-tags
  display flex
  flex-wrap wrap
  justify-content center
  gap 4px
  margin-top 5px
  max-width 130px

.day-player-tags span
  padding 2px 6px
  border-radius 999px
  color var(--primary)
  background rgba(255,218,215,.58)
  font-size 10px
  font-weight 900
  line-height 1.2

.ready-center-piece
  position absolute
  left 50%
  top 52%
  transform translate(-50%, -50%)
  pointer-events none
  width 190px
  height 190px
  border-radius 50%
  display flex
  flex-direction column
  align-items center
  justify-content center
  color #2d4b22
  background rgba(231,226,212,.84)
  border 5px solid rgba(231,226,212,.88)
  box-shadow inset 0 20px 40px rgba(29,28,19,.08), 0 20px 36px rgba(29,28,19,.08)
  text-align center

.ready-center-piece .anticon
  font-size 38px
  margin-bottom 8px

.ready-center-piece strong
  color var(--tertiary)
  font-size 16px

.ready-center-piece span
  margin-top 4px
  color #73796e
  font-size 12px
  font-weight 800

.ready-bottom-actions
  display flex
  gap 14px
  padding 10px
  border 4px solid var(--surface-high)
  border-radius 20px
  background rgba(248,243,229,.94)
  box-shadow 0 18px 38px rgba(29,28,19,.12)

.ready-bottom-actions button
  min-width 96px
  min-height 68px
  border 0
  border-bottom 5px solid #2f1500
  border-radius 12px
  display flex
  flex-direction column
  align-items center
  justify-content center
  gap 7px
  color var(--tertiary-soft)
  background var(--tertiary)
  font-family inherit
  font-weight 900
  cursor pointer

.ready-bottom-actions button:disabled
  opacity .46
  cursor not-allowed

.ready-bottom-actions button.active,
.ready-bottom-actions button:nth-child(3)
  background var(--primary)
  border-bottom-color var(--primary-dark)
  color #fff

.day-action-icon
  width 24px
  height 24px
  object-fit contain
  filter brightness(0) invert(1)

.ready-right-panel
  grid-column 3
  grid-row 2
  z-index 3
  min-height 0
  padding 30px 30px 30px 0
  background var(--surface)

.ready-scroll-panel
  height 100%
  min-height 0
  position relative
  padding 20px 22px 24px
  border-left 8px solid var(--surface-high)
  border-right 8px solid var(--surface-high)
  border-radius 14px 14px 0 0
  display flex
  flex-direction column
  background #fef9eb
  box-shadow 0 20px 42px rgba(29,28,19,.14)
  background-image radial-gradient(#e7e2d4 .55px, transparent .55px)
  background-size 4px 4px

.scroll-roll
  height 14px
  margin -28px -18px 22px
  border-radius 999px
  background var(--surface-high)
  box-shadow 0 6px 12px rgba(29,28,19,.08)

.ready-scroll-panel h3
  margin 0
  color var(--primary)
  font-size 28px
  font-style italic
  font-weight 900
  text-align center

.panel-subtitle
  margin 4px 0 20px
  color #73796e
  font-size 11px
  font-weight 900
  text-align center

.waiting-list
  display flex
  flex-direction column
  gap 12px
  overflow-y auto
  min-height 0

.waiting-player
  display flex
  align-items center
  gap 12px
  padding 10px
  border-radius 12px
  background rgba(248,243,229,.78)
  border 1px solid rgba(231,226,212,.82)

.waiting-player img
  width 48px
  height 48px
  border-radius 10px
  object-fit cover
  border 2px solid var(--tertiary-soft)

.waiting-player strong
  display block
  color var(--primary)
  font-size 14px

.waiting-player span
  display block
  color #73796e
  font-size 11px

.ready-rule-card
  margin-top auto
  padding 16px
  border-left 3px solid var(--primary)
  border-radius 4px
  background rgba(255,218,215,.25)

.ready-rule-card strong
  display block
  color var(--primary)
  margin-bottom 6px

.ready-rule-card span,
.ready-empty-text
  color #43483f
  font-size 13px
  line-height 1.65

.room-day-shell .ready-status-banner h2
  letter-spacing .1em

.room-day-shell .ready-main
  padding-top 30px

.room-day-shell .ready-orbit
  margin-top 18px

.day-speaker-card
  margin-top 0

.day-discussion-list
  display flex
  flex-direction column
  gap 14px
  overflow-y auto
  min-height 0
  padding-right 4px

.day-discussion-item
  padding 12px 0 14px
  border-bottom 1px solid rgba(231,226,212,.76)

.day-discussion-speaker
  color var(--secondary)
  font-size 13px
  font-weight 900
  line-height 1.4

.day-discussion-text
  margin-top 6px
  color #1d1c13
  font-size 14px
  font-style italic
  line-height 1.65

.room-night-shell
  --surface #10140f
  --surface-low #151a14
  --surface-mid #20261f
  --surface-high #2b3229
  --primary #a90c0c
  --primary-dark #650305
  --secondary #ffdf9a
  --secondary-soft #3a3426
  --tertiary #d6c7aa
  --tertiary-soft #fff2c8
  color #ece8dc
  background #10140f

.night-bg
  position fixed
  inset 76px 340px 0 256px
  z-index 0
  pointer-events none
  overflow hidden
  background radial-gradient(circle at 82% 8%, rgba(255,223,154,.16), transparent 10%), linear-gradient(90deg, rgba(10,14,11,.93), rgba(20,28,24,.72)), url("https://lh3.googleusercontent.com/aida-public/AB6AXuDZskf468f36mW0Yzz4qcBkN84ET84qGiuHuUIYs4DWr3tOSXL_iN95yWVupQWp8CHb7Q7A6LVz7WpglvUtW7a1UvlDl1PMTmxBqutoJ4e5DNtplN9vviTK-7hM1troIQZC5chNdLKIERoB82HLxVIMDaCCALOIpnyi1KdBj_Z9RfCHUIyK7MnWCDUQCKb16fRuto1faxaqjH9PhUAdKf-IsYW8d_rla4XBpZv-td5CbWhbhWczp43NfB8YYKVJBDcAEQoYCZHr5SU")
  background-size cover
  background-position center

.night-bg:after
  content ''
  position absolute
  inset 0
  background linear-gradient(0deg, rgba(16,20,15,.95), rgba(16,20,15,.42) 42%, rgba(16,20,15,.7))

.night-topbar
  background rgba(12,16,12,.9)
  border-bottom 1px solid rgba(255,223,154,.12)
  box-shadow 0 16px 34px rgba(0,0,0,.28)

.night-topbar .ready-brand,
.night-topbar button
  color var(--secondary)

.night-room-plaque
  background #22251f
  border-bottom-color #070807

.night-room-plaque span
  color #b5aa8f

.night-sidebar
  background rgba(13,17,13,.96)
  border-right 1px solid rgba(255,223,154,.1)
  box-shadow 22px 0 42px rgba(0,0,0,.26)

.night-sidebar .ready-narrator img
  background #252a23
  border-color rgba(255,223,154,.45)

.night-sidebar .ready-narrator strong
  color var(--secondary)

.night-sidebar .ready-narrator span
  color #b8b49f

.night-sidebar nav button,
.night-sidebar .ready-side-link
  color rgba(236,232,220,.68)

.night-sidebar nav button.active,
.night-sidebar nav button:hover,
.night-sidebar .ready-side-link:hover
  color var(--secondary)
  background rgba(255,223,154,.1)

.night-sidebar .ready-summary
  background rgba(255,255,255,.04)
  border-color rgba(255,223,154,.12)

.night-sidebar .ready-summary div
  color rgba(236,232,220,.72)

.night-sidebar .ready-summary strong
  color var(--secondary)

.night-main
  padding 36px 40px 24px

.night-hero
  display flex
  justify-content space-between
  align-items flex-end
  gap 28px
  margin-bottom 34px

.night-kicker
  display flex
  align-items center
  gap 10px
  color var(--secondary)
  font-size 13px
  font-weight 900
  letter-spacing .12em

.night-hero h2
  margin 12px 0 8px
  color #f5f3eb
  font-size 62px
  line-height 1
  font-weight 900
  letter-spacing 0

.night-hero p
  max-width 620px
  margin 0
  color rgba(236,232,220,.76)
  font-size 18px
  line-height 1.7
  font-style italic

.night-timer
  min-width 170px
  padding 22px 26px
  border-left 4px solid var(--secondary)
  color var(--secondary)
  background rgba(37,41,35,.92)
  box-shadow 12px 14px 0 rgba(0,0,0,.25)
  text-align center

.night-timer span
  display block
  margin-bottom 6px
  font-size 12px
  font-weight 900
  letter-spacing .18em

.night-timer strong
  display block
  color #ffc400
  font-size 38px
  line-height 1

.night-board
  min-height 360px
  display grid
  grid-template-columns repeat(5, minmax(118px, 1fr))
  gap 22px
  align-items stretch
  padding 10px 0 8px

.night-player-card
  position relative
  min-height 218px
  border 2px solid transparent
  border-radius 4px
  padding 18px 16px 16px
  color #ece8dc
  background rgba(38,43,37,.88)
  box-shadow 0 18px 36px rgba(0,0,0,.2)
  display flex
  flex-direction column
  align-items center
  font-family inherit
  cursor default
  transition transform .18s ease, border-color .18s ease, background .18s ease

.night-player-card:disabled
  color #ece8dc

.night-player-actionable
  cursor pointer
  border-color rgba(255,223,154,.38)

.night-player-actionable:hover
  transform translateY(-5px)
  border-color var(--secondary)
  background rgba(51,58,49,.95)

.night-player-muted
  opacity .5

.night-player-self
  background rgba(83,65,35,.92)

.night-player-dead
  opacity .6

.night-player-selected
  border-color #ffb4a8
  box-shadow 0 0 0 1px rgba(255,180,168,.4), 0 18px 36px rgba(0,0,0,.24)

.night-player-number
  position absolute
  right -2px
  top -12px
  min-width 34px
  height 26px
  line-height 26px
  color #2a1b00
  background var(--secondary)
  font-size 13px
  font-weight 900

.night-player-portrait
  position relative
  width 100%
  aspect-ratio 1
  max-width 126px
  overflow hidden
  border 2px solid rgba(255,223,154,.2)
  background #f3eee0

.night-player-portrait img
  width 100%
  height 100%
  object-fit cover
  filter grayscale(.85) contrast(.95)
  transition filter .2s ease

.night-player-actionable:hover .night-player-portrait img,
.night-player-selected .night-player-portrait img
  filter grayscale(0)

.night-player-dead-mask,
.night-player-selected-mark
  position absolute
  inset 0
  display flex
  align-items center
  justify-content center
  color #fff
  background rgba(90,0,5,.56)
  font-size 22px
  font-weight 900

.night-player-selected-mark
  background rgba(169,12,12,.44)
  font-size 34px

.night-player-name
  width 100%
  margin-top 14px
  color #f7f2e8
  font-size 17px
  font-weight 900
  text-align center
  white-space nowrap
  overflow hidden
  text-overflow ellipsis

.night-player-note
  margin-top 5px
  color var(--secondary)
  font-size 11px
  font-weight 900
  text-align center

.night-player-tags
  min-height 20px
  display flex
  flex-wrap wrap
  justify-content center
  gap 4px
  margin-top 8px

.night-player-tags span
  padding 2px 6px
  border-radius 999px
  color #1d1c13
  background rgba(255,223,154,.84)
  font-size 10px
  font-weight 900

.night-player-tags .wolf
  color #fff
  background #a90c0c

.night-player-tags .good
  color #102c17
  background #b7ccb9

.night-actions
  min-height 120px
  display flex
  justify-content center
  align-items center
  gap 30px
  margin-top 22px

.night-action-btn
  width 118px
  min-height 118px
  border 0
  border-radius 2px
  display flex
  flex-direction column
  align-items center
  justify-content center
  gap 10px
  color rgba(236,232,220,.58)
  background rgba(37,41,35,.75)
  box-shadow 0 16px 30px rgba(0,0,0,.22)
  font-family inherit
  font-weight 900
  cursor pointer

.night-action-btn span
  width 58px
  height 58px
  display flex
  align-items center
  justify-content center
  color #fff
  background #181b17
  font-size 30px

.night-action-btn strong
  font-size 16px

.night-action-btn.active span
  background var(--primary)

.night-action-btn.active strong
  color #fff

.night-action-btn:disabled
  opacity .38
  cursor not-allowed

.night-curtain-note
  padding 18px 30px
  border 1px solid rgba(255,223,154,.14)
  color rgba(236,232,220,.66)
  background rgba(255,255,255,.04)
  font-weight 900

.night-result
  max-width 620px
  margin 8px auto 0
  padding 14px 18px
  border-left 3px solid #ffb4a8
  color #f7f2e8
  background rgba(169,12,12,.18)
  display flex
  gap 12px
  align-items center
  justify-content center

.night-result strong
  color #ffb4a8

.night-right-panel
  background #10140f

.night-scroll-panel
  border-left-color #2b3229
  border-right-color #2b3229
  color #ece8dc
  background #171b16
  background-image radial-gradient(rgba(255,223,154,.08) .55px, transparent .55px)
  box-shadow 0 20px 42px rgba(0,0,0,.32)

.night-scroll-panel .scroll-roll
  background #2b3229

.night-scroll-panel h3
  color var(--secondary)

.night-scroll-panel .panel-subtitle
  color rgba(236,232,220,.6)

.night-scroll-panel .ready-rule-card
  background rgba(255,223,154,.08)
  border-left-color var(--secondary)

.night-scroll-panel .ready-rule-card strong
  color var(--secondary)

.night-scroll-panel .ready-rule-card span
  color rgba(236,232,220,.72)

.night-side-stats
  display grid
  gap 12px
  margin-bottom 20px

.night-side-stats div
  display flex
  align-items center
  justify-content space-between
  padding 12px
  background rgba(255,255,255,.04)
  border 1px solid rgba(255,223,154,.1)

.night-side-stats span
  color rgba(236,232,220,.62)
  font-size 12px
  font-weight 900

.night-side-stats strong
  max-width 148px
  color var(--secondary)
  font-size 13px
  text-align right

.night-memo-list
  display flex
  flex-direction column
  gap 12px
  min-height 0
  margin 0 0 18px
  overflow-y auto

.night-memo-item
  display grid
  grid-template-columns 34px 1fr
  gap 10px
  padding 12px
  border 1px solid rgba(255,223,154,.1)
  background rgba(255,255,255,.035)

.night-memo-item span
  width 28px
  height 28px
  line-height 28px
  color #10140f
  background var(--secondary)
  font-size 12px
  font-weight 900
  text-align center

.night-memo-item p
  margin 0
  color rgba(236,232,220,.78)
  font-size 13px
  line-height 1.6
  font-weight 800

.night-side-actions
  display grid
  grid-template-columns 1fr 1fr
  gap 10px
  margin-top 18px

.night-side-actions button
  min-height 46px
  border 0
  border-radius 4px
  display flex
  align-items center
  justify-content center
  gap 8px
  color #10140f
  background var(--secondary)
  font-family inherit
  font-weight 900
  cursor pointer

.settings .setting-cell
  min-height 38px

.settings .fake-input
  min-width 44px
  height 28px
  line-height 28px
  text-align center
  border-radius 6px
  background #f3eee0
  font-weight 900

.settings .icon-font
  color var(--primary)
  font-size 20px
  cursor pointer

@media (max-width 1280px)
  .room-ready-shell
    grid-template-columns 220px minmax(620px, 1fr) 300px

  .ready-bg
    inset 76px 300px 0 220px

  .night-bg
    inset 76px 300px 0 220px

  .night-board
    grid-template-columns repeat(4, minmax(118px, 1fr))

  .ready-sidebar
    padding 24px

  .ready-right-panel
    padding-right 20px

  .ready-orbit
    width min(820px, 100%)
    min-height 440px

  .ready-seat-card
    width 106px

  .ready-seat-frame
    width 78px
    height 78px

  .ready-center-piece
    width 176px
    height 176px

@media (max-width 980px)
  .room-ready-shell
    display block
    height auto
    min-height 100vh
    min-width 0
    overflow-y auto

  .ready-topbar
    position sticky
    top 0
    height 76px

  .ready-room-plaque
    display none

  .ready-sidebar,
  .ready-main,
  .ready-right-panel
    min-height 0

  .ready-sidebar
    border-radius 0

  .ready-bg
    position fixed
    inset 76px 0 0 0

  .night-bg
    position fixed
    inset 76px 0 0 0

  .night-main
    padding 28px 24px

  .night-hero
    flex-direction column
    align-items flex-start

  .night-hero h2
    font-size 42px

  .night-board
    grid-template-columns repeat(2, minmax(132px, 1fr))
    min-height 0

  .night-actions
    flex-wrap wrap

  .night-right-panel
    padding 0 24px 30px

  .ready-orbit
    width 100%
    min-height 0
    display grid
    grid-template-columns repeat(2, minmax(120px, 1fr))
    gap 18px
    justify-items center

  .ready-seat-slot
    position static
    min-height 0
    display flex
    transform none

  .ready-seat-slot-1,
  .ready-seat-slot-2,
  .ready-seat-slot-3,
  .ready-seat-slot-4,
  .ready-seat-slot-5,
  .ready-seat-slot-6,
  .ready-seat-slot-7,
  .ready-seat-slot-8,
  .ready-seat-slot-9,
  .ready-seat-slot-10,
  .ready-seat-slot-11,
  .ready-seat-slot-12,
  .ready-center-piece
    grid-column 1
    grid-row auto

  .ready-seat-slot-1,
  .ready-seat-slot-2,
  .ready-seat-slot-3,
  .ready-seat-slot-4,
  .ready-seat-slot-5,
  .ready-seat-slot-6,
  .ready-seat-slot-7,
  .ready-seat-slot-8,
  .ready-seat-slot-9,
  .ready-seat-slot-10,
  .ready-seat-slot-11,
  .ready-seat-slot-12
    left auto
    top auto
    grid-column auto
    grid-row auto

  .ready-center-piece
    position static
    transform none
    grid-column 1 / 3

  .ready-right-panel
    padding 0 24px 30px
