@media (max-width 1280px)
  .room-ready-shell
    grid-template-columns 220px minmax(620px, 1fr) 300px

  .ready-bg
    inset 76px 300px 0 220px

  .night-bg
    inset 76px 300px 0 220px

  .dusk-bg
    inset 76px 300px 0 220px

  .night-orbit
    width min(860px, 100%)
    min-height 460px

  .ready-sidebar
    padding 24px

  .ready-right-panel
    padding-right 20px

  .ready-orbit
    width min(820px, 100%)
    min-height 440px

  .ready-seat-card
    width 106px

  .ready-seat-frame
    width 78px
    height 78px

  .ready-center-piece
    width 176px
    height 176px

  .settlement-roster
    grid-template-columns 1fr

@media (max-width 980px)
  .room-ready-shell
    display block
    height auto
    min-height 100vh
    min-width 0
    overflow-y auto

  .ready-topbar
    position sticky
    top 0
    height 76px

  .ready-room-plaque
    display none

  .ready-sidebar,
  .ready-main,
  .ready-right-panel
    min-height 0

  .ready-sidebar
    border-radius 0

  .ready-bg
    position fixed
    inset 76px 0 0 0

  .night-bg
    position fixed
    inset 76px 0 0 0

  .dusk-bg
    position fixed
    inset 76px 0 0 0

  .dusk-main
    padding 28px 24px

  .dusk-grid,
  .settlement-grid
    grid-template-columns 1fr

  .dusk-right-panel
    padding 0 24px 30px

  .night-main
    padding 28px 24px

  .night-actions
    flex-wrap wrap

  .night-right-panel
    padding 0 24px 30px

  .ready-orbit
    width 100%
    min-height 0
    display grid
    grid-template-columns repeat(2, minmax(120px, 1fr))
    gap 18px
    justify-items center

  .ready-seat-slot
    position static
    min-height 0
    display flex
    transform none

  .ready-seat-slot-1,
  .ready-seat-slot-2,
  .ready-seat-slot-3,
  .ready-seat-slot-4,
  .ready-seat-slot-5,
  .ready-seat-slot-6,
  .ready-seat-slot-7,
  .ready-seat-slot-8,
  .ready-seat-slot-9,
  .ready-seat-slot-10,
  .ready-seat-slot-11,
  .ready-seat-slot-12,
  .ready-center-piece
    grid-column 1
    grid-row auto

  .ready-seat-slot-1,
  .ready-seat-slot-2,
  .ready-seat-slot-3,
  .ready-seat-slot-4,
  .ready-seat-slot-5,
  .ready-seat-slot-6,
  .ready-seat-slot-7,
  .ready-seat-slot-8,
  .ready-seat-slot-9,
  .ready-seat-slot-10,
  .ready-seat-slot-11,
  .ready-seat-slot-12
    left auto
    top auto
    grid-column auto
    grid-row auto

  .ready-center-piece
    position static
    transform none
    grid-column 1 / 3

  .ready-right-panel
    padding 0 24px 30px
