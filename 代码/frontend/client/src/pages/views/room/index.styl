    border-color #63000a !important
    color #f8efd8 !important
    min-width 100px
    height 40px
    border-radius 8px
    font-family inherit
    font-weight 900
    box-shadow 0 6px 18px rgba(82, 35, 28, 0.2) !important
    transition background .18s ease !important
  .btn-primary:hover,
  .btn-primary:focus
    background #85171b !important
    border-color #85171b !important
  .content-wrap
    width 100%
    .content-view
      border-radius 12px
      border 1px solid rgba(91, 60, 34, 0.14)
      background rgba(243, 236, 218, 0.5)
      overflow auto
      max-height 380px
      margin 0
      padding 16px 14px
      display flex
      flex-wrap wrap
      gap 14px
      justify-content center
      scrollbar-width thin
      scrollbar-color rgba(99, 0, 10, .2) transparent
    .player-cell
      width 138px
      min-height 100px
      margin 0
      border-radius 12px
      border 2px solid rgba(91, 60, 34, 0.18)
      background rgba(254, 249, 235, .95)
      box-shadow 0 6px 18px rgba(29, 28, 19, .1)
      display flex
      flex-direction column
      align-items center
      justify-content center
      gap 5px
      padding 12px 8px
      position relative
      transition box-shadow .18s, border-color .18s, background .18s
    .check-item
      background linear-gradient(160deg, #fdf0dd, #fef9eb) !important
      border-color rgba(99, 0, 10, 0.28) !important
      cursor pointer
      &:hover
        box-shadow 0 10px 24px rgba(99, 0, 10, .18) !important
        border-color rgba(99, 0, 10, 0.52) !important
        background linear-gradient(160deg, #faeacc, #fef0e2) !important
    .normal-item
      background rgba(237, 230, 212, .55) !important
      border-color rgba(91, 60, 34, 0.12) !important
      opacity 0.68
    .target-item
      background rgba(255, 218, 215, .55) !important
      border-color rgba(180, 10, 50, 0.3) !important
    .txt
      font-weight 900
      font-family inherit
      font-size 13px
      line-height 1.3
    .check-text
      color #482400
      font-size 13px
    .normal-text
      color #8a7b68
      font-size 12px
    .camp-tag
      height 22px
      position absolute
      border-radius 11px
      right -6px
      top -10px
      padding 0 9px
      line-height 22px
      font-size 11px
      font-weight 900
      color #ffffff
      box-shadow 0 3px 8px rgba(0, 0, 0, .18)
    .result-view
      margin-top 14px
      padding 14px 16px
      border-left 3px solid #63000a
      border-radius 4px
      background rgba(231, 226, 212, .5)
      .tit
        font-size 14px
        font-weight 900
        color #5d261f
        margin-bottom 8px
      .content
        font-size 14px
        color #482400
    .prompt-view
      font-size 13px
      color #6d3a1a
      font-style italic
      font-weight 800
      margin-top 10px
      padding 10px 14px
      background rgba(255, 218, 215, .3)
      border-radius 6px

