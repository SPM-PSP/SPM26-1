.room-container
  width 100%
  height 100%
  background-color #ffffff
  position relative
  .title-text
    width 100%
    font-size 16px
    font-weight bold
    text-align center
  .full-btn
    width 100%
  .room-wrap
    position relative
    width 100%
    height 100vh
    overflow hidden
    .btn-record
      position fixed
      bottom 80px
      font-size 14px
      font-weight bold
      height 80px
      width 80px
      border-radius 40px
      text-align center
      line-height 80px
      cursor pointer
      left calc(50% + 150px)
    .btn-refresh
      position fixed
      bottom 80px
      font-size 14px
      font-weight bold
      height 80px
      width 80px
      border-radius 40px
      text-align center
      line-height 80px
      cursor pointer
      left 50%
      transform translateX(-50%)
    .btn-next-stage
      position fixed
      bottom 80px
      font-size 14px
      font-weight bold
      height 80px
      width 80px
      border-radius 40px
      text-align center
      line-height 80px
      cursor pointer
      left calc(50% - 230px)
.error-view
  width 100%
  .desc
    font-size 16px
    font-weight 500
    text-align center
/* .player-click-modal – full theme defined near bottom of file */

.game-record-modal
  font-family Georgia, 'Noto Serif SC', 'Noto Serif', serif
  .ant-modal-content
    background #e5d7bd!important
    border 1px solid rgba(79, 52, 29, 0.34)
    border-radius 8px
    overflow hidden
    box-shadow 0 24px 70px rgba(21, 14, 8, 0.34), inset 0 0 0 1px rgba(255,255,255,0.36)
  .ant-modal-header
    background linear-gradient(180deg, #f1e8d6 0%, #e5d7bd 100%)!important
    border-bottom 1px solid rgba(91, 60, 34, 0.22)!important
    padding 22px 26px 16px
  .ant-modal-title
    color #5d261f
  .ant-modal-body
    background #e5d7bd
    padding 0 0 18px!important
  .ant-modal-footer
    background #e5d7bd!important
    border-top 1px solid rgba(91, 60, 34, 0.18)!important
    padding 14px 26px 20px
  .btn-primary
    min-width 96px
    height 38px
    border-radius 4px
    color #f8efd8!important
    background #5d261f!important
    border-color #5d261f!important
    font-weight 700
    letter-spacing 0
    box-shadow 0 5px 14px rgba(82, 35, 28, 0.22)!important
  .game-record-modal-title
    display flex
    align-items center
    gap 12px
    color #5d261f
    svg
      font-size 24px
      padding 8px
      width 42px
      height 42px
      border-radius 50%
      color #efe5cd
      background #5d261f
      box-shadow 0 4px 12px rgba(77, 42, 25, 0.24)
    strong
      display block
      font-size 22px
      line-height 28px
      letter-spacing 0
    span
      display block
      margin-top 2px
      color #75654f
      font-size 13px
      line-height 18px
      font-weight 600
.role-card-wrap
  .card-img
    width 100%
    height auto
.ant-modal-confirm-content
  margin-left 0!important

.winner-wrap
  width 100%
  .img-card-wrap
    position relative
    img
      width 80%
      height auto
    .winner-mask
      position absolute
      width 80%
      height 100%
      left 10%
      top 0
      background-color black
      opacity 0.5
    .winner-mask-text-wrap
      position absolute
      width 80%
      height 100%
      left 10%
      top 0
      img
        width 64px
        height 64px
      .txt
        text-align center
        color #ffffff
        font-weight bold
        font-size 20px
        line-height 100%

.winner-title
  font-size 18px

.mock-settlement-tools
  position fixed
  left 18px
  bottom 18px
  z-index 20
  display flex
  align-items center
  gap 8px
  padding 8px 10px
  border 1px solid rgba(122, 0, 11, .18)
  border-radius 4px
  background rgba(254, 249, 235, .94)
  box-shadow 0 12px 28px -18px rgba(29, 28, 19, .45)
  font-family Georgia, 'Noto Serif SC', 'Noto Serif', serif
  span
    color #5a4b32
    font-size 12px
    font-weight 700
  button
    height 28px
    padding 0 12px
    border 0
    border-radius 3px
    color #fff
    background #63000a
    font-size 12px
    font-weight 800
    cursor pointer
  button:last-child
    background #2d6a4f

.room-sync-shell
  min-height 100vh
  position relative
  display flex
  align-items center
  justify-content center
  color #1d1c13
  background radial-gradient(circle at 50% 38%, #fffdf4 0%, #f8f3e5 44%, #e7e2d4 100%)
  font-family Georgia, 'Noto Serif SC', 'Noto Serif', serif

.room-sync-brand
  position absolute
  left 30px
  top 24px
  color #2d4b22
  font-size 26px
  font-weight 900
  font-style italic

.room-sync-card
  min-width 300px
  padding 50px 62px 46px
  display flex
  flex-direction column
  align-items center
  gap 14px
  border 1px solid rgba(99, 0, 10, .1)
  border-radius 10px
  background rgba(254, 249, 235, .92)
  box-shadow 0 24px 70px -46px rgba(41, 27, 14, .6)

.room-sync-card h2
  margin 8px 0 0
  color #482400
  font-size 22px
  font-weight 900

.room-sync-card p
  margin 0
  color #6d6251
  font-size 14px

.room-sync-spinner
  width 40px
  height 40px
  display block
  border 3px solid rgba(99, 0, 10, .12)
  border-top-color #63000a
  border-radius 50%
  animation room-sync-spin .85s linear infinite

@keyframes room-sync-spin
  from
    transform rotate(0deg)
  to
    transform rotate(360deg)

.room-ready-shell
  --surface #fef9eb
  --surface-low #f8f3e5
  --surface-mid #f3eee0
  --surface-high #e7e2d4
  --primary #63000a
  --primary-dark #410004
  --secondary #546432
  --secondary-soft #d7eaab
  --tertiary #482400
  --tertiary-soft #ffdcc3
  width 100%
  height 100vh
  min-height 680px
  display grid
  grid-template-columns 256px minmax(720px, 1fr) 340px
  grid-template-rows 76px minmax(0, 1fr)
  position relative
  overflow-x auto
  overflow-y hidden
  color #1d1c13
  background var(--surface)
  font-family Georgia, 'Noto Serif SC', 'Noto Serif', serif

.ready-bg
  position fixed
  inset 76px 340px 0 256px
  z-index 0
  pointer-events none
  background var(--surface-low)
  overflow hidden

.ready-bg img
  width 100%
  height 100%
  object-fit cover
  opacity .3
  filter sepia(.08) saturate(.85)

.ready-bg:after
  content ''
  position absolute
  inset 0
  background linear-gradient(0deg, rgba(254,249,235,.88), rgba(254,249,235,.42) 34%, rgba(254,249,235,.18) 68%, rgba(254,249,235,.72))

.ready-topbar
  grid-column 1 / 4
  grid-row 1
  z-index 5
  position relative
  display flex
  align-items center
  justify-content space-between
  padding 0 30px
  background linear-gradient(180deg, rgba(231,226,212,.82), rgba(254,249,235,.88))
  box-shadow 0 10px 30px -18px rgba(29,28,19,.28)

.ready-brand
  color #2d4b22
  font-size 26px
  font-weight 900
  font-style italic

.ready-topbar nav
  display flex
  gap 30px
  margin-left 28px
  margin-right auto

.ready-topbar button
  border 0
  background transparent
  color var(--secondary)
  cursor pointer
  font-family inherit
  font-size 16px
  font-weight 900
  font-style italic

.ready-room-plaque
  position absolute
  left 50%
  bottom -18px
  transform translateX(-50%)
  min-width 150px
  padding 9px 22px 12px
  border-radius 8px
  border-bottom 4px solid #2f1500
  display flex
  flex-direction column
  align-items center
  background var(--tertiary)
  box-shadow 0 12px 24px rgba(29,28,19,.22)

.ready-room-plaque span
  color var(--tertiary-soft)
  font-size 10px
  font-weight 900

.ready-room-plaque strong
  color #fff
  font-size 22px
  line-height 1.1

.ready-sidebar
  grid-column 1
  grid-row 2
  z-index 3
  min-height 0
  padding 26px 30px 24px
  display flex
  flex-direction column
  gap 24px
  background var(--surface-low)
  border-radius 0 30px 0 0
  box-shadow 22px 0 42px rgba(29,28,19,.08)

.ready-narrator
  display flex
  align-items center
  gap 14px

.ready-narrator img
  width 56px
  height 56px
  border-radius 50%
  border 2px solid var(--primary)
  object-fit cover

.ready-narrator img.identity-portrait
  object-position center 18%

.ready-narrator-portrait
  width 56px
  height 56px
  flex none
  overflow hidden
  border 2px solid var(--primary)
  border-radius 50%
  background #fff

.ready-narrator-portrait img
  width 100%
  height 100%
  border 0
  border-radius 0
  object-fit cover

.ready-narrator-portrait img.identity-portrait
  object-position center 15%
  transform scale(1.3)
  transform-origin center 22%

.ready-narrator strong
  display block
  color var(--primary)
  font-size 18px

.ready-narrator span
  display block
  color var(--secondary)
  font-size 12px
  line-height 1.4

.ready-sidebar nav
  display flex
  flex-direction column
  gap 10px

.ready-sidebar nav button,
.ready-side-link
  min-height 44px
  border 0
  border-radius 12px
  display flex
  align-items center
  gap 14px
  padding 0 12px
  color rgba(90,106,55,.76)
  background transparent
  cursor pointer
  font-family inherit
  font-size 14px
  font-weight 800
  text-align left

.ready-sidebar nav button.active,
.ready-sidebar nav button:hover,
.ready-side-link:hover
  color var(--primary)
  background rgba(231,226,212,.72)

.ready-summary
  display grid
  gap 10px
  padding 16px
  border-radius 14px
  background rgba(254,249,235,.74)
  border 1px solid rgba(231,226,212,.8)

.ready-summary div
  display flex
  align-items center
  justify-content space-between
  color #43483f
  font-size 12px

.ready-summary strong
  color var(--primary)
  font-size 15px

.ready-start-btn
  min-height 58px
  border 0
  border-radius 14px
  color #fff
  background linear-gradient(135deg, var(--primary), #85171b)
  box-shadow 0 16px 26px rgba(99,0,10,.2)
  font-family inherit
  font-size 18px
  font-weight 900
  cursor pointer

.ready-start-btn:disabled
  opacity .48
  cursor not-allowed

.ready-end-btn
  min-height 52px
  border 2px solid var(--primary)
  border-radius 14px
  color var(--primary)
  background rgba(254,249,235,.7)
  font-family inherit
  font-size 17px
  font-weight 900
  cursor pointer

.ready-end-btn:hover
  color #fff
  background var(--primary)

.ready-side-link
  margin-top auto

.ready-rules-modal
  font-family Georgia, 'Noto Serif SC', 'Noto Serif', serif

.ready-rules-modal .ant-modal-content
  overflow hidden
  border-radius 22px
  background #fef9eb
  box-shadow 0 28px 70px rgba(42, 26, 17, .28)

.ready-rules-modal .ant-modal-header
  padding 24px 30px 10px
  border-bottom 0
  background linear-gradient(180deg, #fff8ea, #fef9eb)

.ready-rules-modal .ant-modal-body
  padding 0 30px 24px
  background #fef9eb

.ready-rules-modal .ant-modal-footer
  padding 14px 30px 24px
  border-top 0
  background #fef9eb

.ready-rules-title
  display flex
  align-items center
  gap 10px
  color var(--primary)
  font-size 24px
  font-weight 900
  font-style italic

.ready-rules-shell
  max-height min(68vh, 640px)
  overflow-y auto
  padding-right 8px
  scrollbar-width thin
  scrollbar-color rgba(99, 0, 10, .2) transparent

.ready-rules-brief
  margin 0 0 18px
  padding 13px 18px
  border-left 4px solid #63000a
  border-radius 0 10px 10px 0
  background rgba(231, 226, 212, .55)

.ready-rules-brief strong
  display block
  color #63000a
  font-size 15px
  line-height 1.5

.ready-rules-brief span
  display block
  margin-top 4px
  color #5e583d
  font-size 13px
  line-height 1.65

/* section card layout */
.rr-preamble
  margin 0 0 14px
  color #342c20
  font-size 14px
  line-height 1.8

.rr-preamble h1
  display none

.rr-section
  margin 0 0 16px
  border 1px solid rgba(99, 0, 10, .15)
  border-radius 12px
  overflow hidden
  background rgba(254, 249, 235, .65)
  box-shadow 0 4px 16px rgba(29, 28, 19, .07)

.rr-section-title
  margin 0
  padding 13px 20px 12px
  color #4d2811
  background linear-gradient(120deg, rgba(231, 226, 212, .92), rgba(243, 238, 224, .82))
  border-bottom 1px solid rgba(99, 0, 10, .1)
  font-size 17px
  font-weight 900
  line-height 1.3

.rr-section-body
  padding 14px 20px 16px
  color #342c20
  font-size 13.5px
  line-height 1.82

.rr-section-body h3
  margin 16px 0 7px
  padding-bottom 7px
  border-bottom 1px solid rgba(99, 0, 10, .12)
  color #63000a
  font-size 15px
  font-weight 900

.rr-section-body h3:first-child
  margin-top 4px

.rr-section-body h4
  margin 13px 0 5px
  padding-left 10px
  border-left 3px solid #546432
  color #3d4c1d
  font-size 13.5px
  font-weight 900

.rr-section-body p
  margin 0 0 8px

.rr-section-body ul
  margin 4px 0 10px
  padding 10px 14px 10px 30px
  border-radius 8px
  background rgba(255, 255, 255, .5)
  border 1px solid rgba(231, 226, 212, .8)

.rr-section-body li
  margin 4px 0
  color #342c20

.ready-rules-divider
  height 1px
  margin 12px 0
  background linear-gradient(90deg, transparent, rgba(99, 0, 10, .22), transparent)

.rr-step
  display grid
  grid-template-columns 24px 1fr
  align-items flex-start
  gap 11px
  margin 5px 0
  padding 9px 14px
  border-radius 8px
  background rgba(248, 243, 229, .72)
  border 1px solid rgba(231, 226, 212, .72)
  font-size 13.5px
  line-height 1.7
  color #342c20

.rr-step-num
  display inline-flex
  align-items center
  justify-content center
  width 24px
  height 24px
  flex none
  border-radius 50%
  color #fff
  background #63000a
  font-size 12px
  font-weight 900
  margin-top 2px

.ready-main
  grid-column 2
  grid-row 2
  z-index 2
  min-width 0
  min-height 0
  overflow-y auto
  padding 22px 30px 18px

.ready-square-card
  position relative
  min-height 0
  height 100%
  display flex
  flex-direction column
  align-items center
  justify-content space-between

.ready-status-banner
  min-width 390px
  padding 12px 44px
  border 3px solid var(--secondary)
  border-radius 999px
  background rgba(215,234,171,.92)
  text-align center
  box-shadow 0 18px 36px rgba(29,28,19,.12)

.ready-status-banner h2
  margin 0
  color var(--secondary)
  font-size 30px
  line-height 1.1
  font-weight 900
  letter-spacing .16em

.ready-status-banner p
  margin 6px 0 0
  color #3d4c1d
  font-size 13px

.ready-orbit
  position relative
  width min(920px, 100%)
  flex 1
  min-height 480px
  margin 10px 0 8px
  display grid
  grid-template-columns repeat(5, 1fr)
  grid-template-rows repeat(3, 1fr)
  gap 28px 16px
  align-items center
  justify-items center

.ready-seat-card
  position relative
  transform none
  width 112px
  border 0
  background transparent
  display flex
  flex-direction column
  align-items center
  cursor pointer
  font-family inherit

.ready-seat-slot
  position static
  display flex
  align-items center
  justify-content center
  min-width 0
  min-height 0

.ready-seat-slot-1
  grid-column 1
  grid-row 1

.ready-seat-slot-2
  grid-column 2
  grid-row 1

.ready-seat-slot-3
  grid-column 3
  grid-row 1

.ready-seat-slot-4
  grid-column 4
  grid-row 1

.ready-seat-slot-5
  grid-column 5
  grid-row 1

.ready-seat-slot-6
  grid-column 1
  grid-row 2

.ready-seat-slot-7
  grid-column 5
  grid-row 2

.ready-seat-slot-8
  grid-column 1
  grid-row 3

.ready-seat-slot-9
  grid-column 2
  grid-row 3

.ready-seat-slot-10
  grid-column 3
  grid-row 3

.ready-seat-slot-11
  grid-column 4
  grid-row 3

.ready-seat-slot-12
  grid-column 5
  grid-row 3

.ready-seat-slot-1 .ready-seat-frame,
.ready-seat-slot-5 .ready-seat-frame,
.ready-seat-slot-10 .ready-seat-frame
  transform rotate(-4deg)

.ready-seat-slot-2 .ready-seat-frame,
.ready-seat-slot-8 .ready-seat-frame,
.ready-seat-slot-12 .ready-seat-frame
  transform rotate(3deg)

.ready-seat-slot-3 .ready-seat-frame,
.ready-seat-slot-6 .ready-seat-frame,
.ready-seat-slot-11 .ready-seat-frame
  transform rotate(2deg)

.ready-seat-slot-4 .ready-seat-frame,
.ready-seat-slot-7 .ready-seat-frame,
.ready-seat-slot-9 .ready-seat-frame
  transform rotate(-2deg)

.ready-seat-frame
  position relative
  width 82px
  height 82px
  padding 7px
  border-radius 12px
  background var(--tertiary)
  border-bottom 5px solid #2f1500
  box-shadow 0 18px 32px rgba(47,21,0,.24)
  transform rotate(-4deg)
  transition transform .2s ease

.ready-seat-card:hover .ready-seat-frame
  transform scale(1.05) rotate(0deg)

.ready-seat-frame img,
.ready-seat-placeholder
  width 100%
  height 100%
  border 2px solid var(--tertiary-soft)
  border-radius 7px
  object-fit cover
  background #fff

.ready-seat-frame img.identity-portrait
  object-position center 18%

.ready-seat-placeholder
  display flex
  align-items center
  justify-content center
  color rgba(72,36,0,.42)
  background rgba(254,249,235,.84)
  font-size 28px

.ready-seat-number
  position absolute
  left 50%
  top -11px
  transform translateX(-50%)
  min-width 42px
  padding 2px 8px
  border-radius 999px
  color #fff
  background var(--primary)
  font-size 11px
  font-weight 900

.ready-seat-name
  margin-top 7px
  max-width 130px
  padding 3px 10px
  border-radius 4px
  color #fff
  background var(--primary)
  font-size 12px
  line-height 1.3
  font-weight 900
  white-space nowrap
  overflow hidden
  text-overflow ellipsis

.ready-seat-note
  margin-top 4px
  color var(--secondary)
  font-size 11px
  font-weight 800

.ready-seat-empty .ready-seat-frame
  background rgba(72,36,0,.46)
  border-bottom-color rgba(47,21,0,.58)

.ready-seat-empty .ready-seat-name
  color var(--primary)
  background var(--tertiary-soft)

.ready-seat-reserve
  opacity .74

.ready-seat-kick .ready-seat-frame
  background #85171b
  border-bottom-color var(--primary-dark)

.ready-day-player
  cursor default
  z-index 3

.ready-day-player .ready-seat-name,
.ready-day-player .ready-seat-note,
.ready-day-player .day-player-tags
  position relative
  z-index 6

.ready-day-player.day-player-self .ready-seat-frame
  background #85171b
  border-bottom-color var(--primary-dark)

.room-day-shell .ready-day-player.day-player-self
  position relative
  filter drop-shadow(0 0 13px rgba(126,17,24,.32))

.room-day-shell .ready-day-player.day-player-self .ready-seat-frame
  background #7e1118
  border-bottom-color #4a0006
  box-shadow 0 0 0 4px #f3c96e, 0 0 0 7px rgba(126,17,24,.32), 0 20px 34px rgba(74,0,6,.3)

.room-day-shell .ready-day-player.day-player-self .ready-seat-frame:before
  content '我'
  position absolute
  z-index 4
  top -15px
  right -14px
  width 29px
  height 29px
  line-height 27px
  border 2px solid #7e1118
  border-radius 50%
  background #ffdf9a
  color #7e1118
  box-shadow 0 5px 12px rgba(74,0,6,.28)
  font-size 13px
  font-weight 900
  text-align center

.room-day-shell .ready-day-player.day-player-self .ready-seat-name
  box-shadow 0 0 0 2px #f3c96e

.room-day-shell .ready-day-player.day-player-self .ready-seat-note
  color #7e1118
  font-weight 900

.ready-day-player.day-player-dead
  opacity .72

.ready-day-player.day-player-dead .ready-seat-frame img
  filter grayscale(1)
  opacity .52

.ready-day-player.day-player-dead .ready-seat-frame:after
  content '出局'
  position absolute
  inset 7px
  border-radius 7px
  display flex
  align-items center
  justify-content center
  color #fff
  background rgba(65,0,4,.62)
  font-size 16px
  font-weight 900

.room-day-shell .ready-day-player.day-player-speaking
  opacity 1
  filter drop-shadow(0 0 16px rgba(243, 201, 110, .52))

.room-day-shell .ready-day-player.day-player-speaking .ready-seat-frame
  box-shadow 0 0 0 4px #f3c96e, 0 0 0 8px rgba(96, 116, 49, .28), 0 20px 34px rgba(74, 50, 10, .22)

.room-day-shell .ready-day-player.day-player-speaking .ready-seat-name
  background #f3c96e
  color #4a0006
  box-shadow 0 0 0 2px rgba(74, 0, 6, .18)

.room-day-shell .ready-day-player.day-player-speaking .ready-seat-note
  color var(--primary)
  font-weight 1000

.day-player-tags
  display flex
  flex-wrap wrap
  justify-content center
  gap 4px
  margin-top 5px
  max-width 130px

.day-player-tags span
  padding 2px 6px
  border-radius 999px
  color var(--primary)
  background rgba(255,218,215,.58)
  font-size 10px
  font-weight 900
  line-height 1.2

.day-player-tags .wolf
  color #fff
  background var(--primary)

.day-player-tags .good
  color #102c17
  background #b7ccb9

.ready-center-piece
  position absolute
  z-index 1
  left 50%
  top calc(50% - 18px)
  transform translate(-50%, -50%)
  pointer-events none
  width 190px
  height 190px
  border-radius 50%
  display flex
  flex-direction column
  align-items center
  justify-content center
  color #2d4b22
  background rgba(231,226,212,.84)
  border 5px solid rgba(231,226,212,.88)
  box-shadow inset 0 20px 40px rgba(29,28,19,.08), 0 20px 36px rgba(29,28,19,.08)
  text-align center

.ready-center-piece .anticon
  font-size 38px
  margin-bottom 8px

.ready-center-piece strong
