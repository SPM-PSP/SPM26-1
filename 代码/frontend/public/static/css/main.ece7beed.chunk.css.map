.player-click-modal .content-wrap .action-player-avatar {
  width: 70px;
  height: 70px;
  padding: 5px;
  border-radius: 10px;
  background: #4a2106;
  box-shadow: 0 8px 16px rgba(29,20,12,0.22);
}
.player-click-modal .content-wrap .action-player-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 7px;
  background: #f8efd8;
}
.player-click-modal .content-wrap .action-player-avatar .identity-portrait {
  object-fit: contain;
  background: #f8efd8;
}
.player-click-modal .content-wrap .action-player-meta {
  width: 100%;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
}
.player-click-modal .content-wrap .action-player-meta span {
  margin-top: 2px;
  padding: 2px 8px;
  border-radius: 10px;
  color: #6d5a43;
  background: rgba(232,214,189,0.56);
  font-size: 11px;
  line-height: 16px;
  font-weight: 900;
}
.player-click-modal .content-wrap .check-item {
  background: linear-gradient(160deg, #fdf0dd, #fef9eb) !important;
  border-color: rgba(99,0,10,0.28) !important;
