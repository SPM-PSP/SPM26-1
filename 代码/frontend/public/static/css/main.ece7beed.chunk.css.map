.identity-reveal {
  position: fixed;
  inset: 0;
  z-index: 3000;
  overflow-y: auto;
  min-height: 100vh;
  background: #343028;
  color: #fff9e6;
  font-family: Georgia, "Times New Roman", "Noto Serif SC", serif;
}
.identity-reveal:after {
  content: "";
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  height: 160px;
  pointer-events: none;
  background: linear-gradient(0deg, rgba(225,217,198,0.72), rgba(225,217,198,0));
}
.identity-reveal .identity-bg-gradient {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background: linear-gradient(180deg, #343028 0%, #7b3f00 52%, #e1d9c6 100%);
}
.identity-reveal .identity-bg-image {
  position: fixed;
  inset: 0;
  z-index: 0;
  background-size: cover;
  background-position: center;
  opacity: 0.5;
  transform: scale(1.05);
  mix-blend-mode: overlay;
  filter: saturate(0.95) sepia(0.16);
}
.identity-reveal .identity-bg-grain {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 1;
  opacity: 0.05;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
}
.identity-reveal .identity-mote {
  position: fixed;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #ffcc80;
  filter: blur(5px);
  opacity: 0.5;
}
.identity-reveal .identity-mote-a {
  top: 28%;
  left: 20%;
}
.identity-reveal .identity-mote-b {
  top: 22%;
  right: 24%;
  width: 7px;
  height: 7px;
}
.identity-reveal .identity-mote-c {
  bottom: 30%;
  right: 35%;
  width: 12px;
  height: 12px;
}
.identity-reveal .identity-topbar {
  position: relative;
  z-index: 2;
  min-height: 96px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 24px;
}
.identity-reveal .identity-brand-mark {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2e1500;
  background: #ffcc80;
  font-weight: 900;
}
.identity-reveal .identity-brand-name {
  font-size: 30px;
  font-weight: 900;
  font-style: italic;
  letter-spacing: 0;
}
.identity-reveal .identity-main {
  position: relative;
  z-index: 2;
  width: calc(100% - 40px);
  max-width: 980px;
  min-height: calc(100vh - 124px);
  margin: 0 auto;
  padding: 16px 0 54px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 56px;
}
.identity-reveal .identity-card-shell {
  position: relative;
  flex: 0 0 320px;
}
.identity-reveal .identity-card-glow {
  position: absolute;
  inset: -18px;
  background: #ffb74d;
  opacity: 0.18;
  filter: blur(36px);
  border-radius: 999px;
}
.identity-reveal .identity-card {
  position: relative;
  width: 320px;
  height: 500px;
  padding: 8px;
  border-radius: 14px;
  background: rgba(229,220,201,0.96);
  box-shadow: 0 26px 70px rgba(0,0,0,0.42);
}
.identity-reveal .identity-card-inner {
  height: 100%;
  padding: 16px;
  border-radius: 9px;
  background: #f7f1e0;
  color: #1e1b16;
  display: flex;
  flex-direction: column;
}
.identity-reveal .identity-card-head {
  height: 34px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #4d4639;
  font-weight: 800;
  font-style: italic;
}
.identity-reveal .identity-crosshair {
  width: 25px;
  height: 25px;
  border: 2px solid #7b3f00;
  border-radius: 50%;
  position: relative;
}
.identity-reveal .identity-crosshair:before,
.identity-reveal .identity-crosshair:after {
  content: "";
  position: absolute;
  background: #7b3f00;
}
.identity-reveal .identity-crosshair:before {
  width: 2px;
  height: 31px;
  left: 10px;
  top: -5px;
}
.identity-reveal .identity-crosshair:after {
  height: 2px;
  width: 31px;
  left: -5px;
  top: 10px;
}
.identity-reveal .identity-portrait {
  position: relative;
  height: 276px;
  margin: 12px 0 18px;
  overflow: hidden;
  border-radius: 10px;
  background: #eae1cc;
  box-shadow: inset 0 0 32px rgba(0,0,0,0.18);
}
.identity-reveal .identity-portrait img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.identity-reveal .identity-role-banner {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 12px;
  display: flex;
  justify-content: center;
}
.identity-reveal .identity-role-banner span {
  min-width: 92px;
  padding: 5px 24px;
  border-radius: 999px;
  text-align: center;
  color: #fff;
  font-size: 20px;
  font-weight: 900;
  letter-spacing: 0;
  background: rgba(123,63,0,0.88);
  box-shadow: 0 8px 18px rgba(0,0,0,0.24);
}
.identity-reveal .identity-flavor {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  text-align: center;
}
.identity-reveal .identity-flavor p {
  margin: 0 4px 18px;
  color: rgba(30,27,22,0.82);
  font-size: 14px;
  line-height: 1.65;
  font-style: italic;
}
.identity-reveal .identity-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
  padding-top: 14px;
  box-shadow: inset 0 1px 0 rgba(126,118,103,0.22);
}
.identity-reveal .identity-stat {
  text-align: left;
}
.identity-reveal .identity-stat-label {
  margin-bottom: 6px;
  color: #4d4639;
  font-size: 10px;
  font-weight: 900;
}
.identity-reveal .identity-stat-row {
  display: flex;
  align-items: center;
  gap: 6px;
  color: #7b3f00;
  font-size: 12px;
  font-weight: 900;
}
.identity-reveal .identity-stat-track {
  flex: 1;
  height: 7px;
  overflow: hidden;
  border-radius: 999px;
  background: #e5dcc9;
}
.identity-reveal .identity-stat-fill {
  height: 100%;
  border-radius: 999px;
  background: #7b3f00;
}
.identity-reveal .identity-copy {
  flex: 1;
  max-width: 510px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 24px;
  text-align: left;
}
.identity-reveal .identity-chip {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 7px 13px;
  border-radius: 999px;
  color: #4a3c1d;
  background: #fce48d;
  font-size: 12px;
  font-weight: 900;
}
.identity-reveal .identity-chip-icon {
  width: 12px;
  height: 12px;
  border: 2px solid currentColor;
  border-radius: 50%;
  box-shadow: 0 0 0 4px rgba(74,60,29,0.12);
}
.identity-reveal h2 {
  margin: 0;
  color: #fff9e6;
  font-size: 58px;
  line-height: 1.05;
  font-weight: 900;
  letter-spacing: 0;
}
.identity-reveal h2 em {
  color: #ffcc80;
  font-style: italic;
}
.identity-reveal .identity-desc {
  max-width: 500px;
  margin: 0;
  color: rgba(255,249,230,0.82);
  font-size: 19px;
  line-height: 1.65;
  font-weight: 700;
}
.identity-reveal .identity-actions {
  display: flex;
  align-items: center;
  gap: 22px;
  flex-wrap: wrap;
}
.identity-reveal .identity-primary-btn {
  border: 0;
  cursor: pointer;
  min-height: 64px;
  padding: 0 34px;
  border-radius: 14px;
  background: linear-gradient(135deg, #7b3f00, #5d2f00);
  color: #fff;
  font-size: 20px;
  font-weight: 900;
  box-shadow: 0 22px 48px rgba(0,0,0,0.28);
  display: inline-flex;
  align-items: center;
  gap: 12px;
  transition: transform 0.18s ease, filter 0.18s ease;
}
.identity-reveal .identity-primary-btn:hover {
  transform: translateY(-2px);
  filter: brightness(1.08);
}
.identity-reveal .identity-primary-btn:active {
  transform: translateY(0) scale(0.98);
}
.identity-reveal .identity-arrow {
  font-size: 24px;
}
.identity-reveal .identity-ghost-btn {
  border: 0;
  cursor: pointer;
  padding: 0;
  background: transparent;
  color: #f7f1e0;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-weight: 900;
  font-size: 14px;
}
.identity-reveal .identity-ghost-btn:hover {
  color: #ffcc80;
}
.identity-reveal .identity-scroll-icon {
  width: 18px;
  height: 22px;
  border-radius: 2px;
  background: linear-gradient(90deg, transparent 42%, currentColor 42%, currentColor 58%, transparent 58%), linear-gradient(currentColor, currentColor);
  opacity: 0.9;
}
.identity-reveal .identity-lore {
  width: 100%;
  max-width: 460px;
  display: flex;
  gap: 16px;
  padding: 22px;
  border-radius: 18px;
  background: rgba(247,241,224,0.12);
  color: #fdf8e6;
  backdrop-filter: blur(14px);
  box-shadow: inset 0 0 0 1px rgba(237,227,210,0.14);
}
.identity-reveal .identity-lore h3 {
  margin: 0 0 7px;
  color: #fff9e6;
  font-size: 18px;
  font-weight: 900;
}
.identity-reveal .identity-lore p {
  margin: 0;
  color: rgba(237,227,210,0.86);
  font-size: 14px;
  line-height: 1.7;
}
.identity-reveal .identity-lore-icon {
  flex: 0 0 46px;
  height: 46px;
  border-radius: 14px;
  background: rgba(93,47,0,0.35);
  position: relative;
}
.identity-reveal .identity-lore-icon:before {
  content: "";
  position: absolute;
  inset: 12px;
  border: 2px solid #ffcc80;
  border-radius: 50%;
}
.identity-reveal .identity-lore-icon:after {
  content: "";
  position: absolute;
  width: 18px;
  height: 2px;
  background: #ffcc80;
  right: 7px;
  bottom: 12px;
  transform: rotate(45deg);
  border-radius: 999px;
}
.identity-reveal .identity-close {
  position: fixed;
  z-index: 3;
  top: 18px;
  right: 20px;
  width: 40px;
  height: 40px;
  border: 0;
  border-radius: 50%;
  background: rgba(255,249,230,0.16);
  color: #fff9e6;
  font-size: 30px;
  line-height: 36px;
  cursor: pointer;
  backdrop-filter: blur(10px);
}
.identity-reveal-amber {
  background: #343028;
}
.identity-reveal-amber:after {
  height: 180px;
  background: linear-gradient(0deg, rgba(225,217,198,0.76), rgba(225,217,198,0));
}
.identity-reveal-amber .identity-bg-gradient {
  background: linear-gradient(180deg, #343028 0%, #7b3f00 52%, #e1d9c6 100%);
}
.identity-reveal-amber .identity-bg-image {
  opacity: 0.5;
  transform: scale(1.05);
  mix-blend-mode: overlay;
  filter: saturate(0.95) sepia(0.16);
}
.identity-reveal-amber .identity-mote {
  background: #fce48d;
}
.identity-reveal-crimson {
  background: #0f080a;
}
.identity-reveal-crimson:after {
  background: linear-gradient(0deg, rgba(18,8,10,0.86), rgba(18,8,10,0));
}
.identity-reveal-crimson .identity-bg-gradient {
  background: linear-gradient(180deg, #080406 0%, #482400 48%, #1a0b0d 100%);
}
.identity-reveal-crimson .identity-bg-image {
  opacity: 0.8;
  transform: scale(1.1);
  mix-blend-mode: normal;
  filter: saturate(0.8);
}
.identity-reveal-crimson .identity-card-glow {
  background: #ff4d4d;
}
.identity-reveal-crimson .identity-role-banner span,
.identity-reveal-crimson .identity-stat-fill {
  background: #8f141b;
}
.identity-reveal-crimson .identity-stat-row {
  color: #8f141b;
}
.identity-reveal-crimson h2 em {
  color: #ff4d4d;
}
.identity-reveal-crimson .identity-primary-btn {
  background: linear-gradient(135deg, #8f141b, #3d0609);
}
.identity-reveal-violet {
  background: #120b1e;
}
.identity-reveal-violet:after {
  background: linear-gradient(0deg, rgba(18,11,30,0.9), rgba(18,11,30,0.78) 30%, rgba(18,11,30,0));
}
.identity-reveal-violet .identity-bg-gradient {
  background: linear-gradient(180deg, #0a0612 0%, #2a1b3d 50%, #120b1e 100%);
}
.identity-reveal-violet .identity-bg-image {
  opacity: 0.3;
  transform: scale(1.1);
  mix-blend-mode: screen;
}
.identity-reveal-violet .identity-card-glow {
  background: #b39ddb;
}
.identity-reveal-violet .identity-role-banner span,
.identity-reveal-violet .identity-stat-fill {
  background: #4f378b;
}
.identity-reveal-violet .identity-stat-row {
  color: #4f378b;
}
.identity-reveal-violet h2 em {
  color: #d9c2ff;
}
.identity-reveal-violet .identity-primary-btn {
  background: linear-gradient(135deg, #4f378b, #7b5bc7);
}
.identity-reveal-green {
  background: #323127;
}
.identity-reveal-green:after {
  background: linear-gradient(0deg, rgba(254,249,235,0.9), rgba(254,249,235,0));
}
.identity-reveal-green .identity-bg-gradient {
  background: linear-gradient(180deg, #323127 0%, #546432 48%, #dedacc 100%);
}
.identity-reveal-green .identity-bg-image {
  opacity: 0.4;
  transform: scale(1.1);
  mix-blend-mode: overlay;
}
.identity-reveal-green .identity-card-glow {
  background: #a5d6a7;
}
.identity-reveal-green .identity-role-banner span,
.identity-reveal-green .identity-stat-fill {
  background: #2e7d32;
}
.identity-reveal-green .identity-stat-row {
  color: #2e7d32;
}
.identity-reveal-green h2 em {
  color: #c8e6c9;
}
.identity-reveal-green .identity-primary-btn {
  background: linear-gradient(135deg, #2e7d32, #17491f);
}
.identity-reveal-meadow {
  background: #fef9eb;
  color: #1e1c0e;
}
.identity-reveal-meadow:after {
  background: linear-gradient(0deg, rgba(254,249,235,0.92), rgba(254,249,235,0));
}
.identity-reveal-meadow .identity-bg-gradient {
  background: linear-gradient(180deg, rgba(99,0,10,0.3) 0%, rgba(84,100,50,0.2) 50%, #fef9eb 100%);
}
.identity-reveal-meadow .identity-bg-image {
  opacity: 0.3;
  transform: scale(1.1);
  mix-blend-mode: overlay;
}
.identity-reveal-meadow .identity-brand-name,
.identity-reveal-meadow h2 {
  color: #1e1c0e;
}
.identity-reveal-meadow h2 em {
  color: #7b3f00;
}
.identity-reveal-meadow .identity-desc,
.identity-reveal-meadow .identity-ghost-btn {
  color: rgba(30,28,14,0.78);
}
.identity-reveal-meadow .identity-lore {
  background: rgba(255,255,255,0.42);
  color: #1e1c0e;
}
.identity-reveal-meadow .identity-lore h3 {
  color: #1e1c0e;
}
.identity-reveal-meadow .identity-lore p {
  color: rgba(30,28,14,0.72);
}
@media (max-width: 820px) {
  .identity-reveal .identity-topbar {
    min-height: 74px;
    padding: 18px 56px 10px;
  }
  .identity-reveal .identity-brand-name {
    font-size: 24px;
  }
  .identity-reveal .identity-main {
    width: calc(100% - 28px);
    max-width: 460px;
    min-height: auto;
    padding: 4px 0 36px;
    flex-direction: column;
    gap: 28px;
  }
  .identity-reveal .identity-card-shell {
    flex: none;
  }
  .identity-reveal .identity-card {
    width: calc(100vw - 52px);
    max-width: 320px;
    height: auto;
    min-height: 452px;
  }
  .identity-reveal .identity-portrait {
    height: 238px;
  }
  .identity-reveal .identity-copy {
    width: 100%;
    align-items: center;
    text-align: center;
    gap: 18px;
  }
  .identity-reveal h2 {
    font-size: 42px;
  }
  .identity-reveal .identity-desc {
    font-size: 16px;
  }
  .identity-reveal .identity-actions {
    justify-content: center;
  }
  .identity-reveal .identity-primary-btn {
    width: 100%;
    justify-content: center;
  }
  .identity-reveal .identity-lore {
    text-align: left;
  }
}