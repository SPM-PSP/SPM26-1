  transition: filter 0.2s ease;
}
.night-player-actionable:hover .night-seat-frame img,
.night-player-selected .night-seat-frame img {
  filter: grayscale(0);
}
.night-player-dead-mask,
.night-player-selected-mark {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: rgba(63,8,11,0.66);
  font-size: 22px;
  font-weight: 900;
}
.night-player-selected-mark {
  background: rgba(111,17,21,0.58);
  font-size: 34px;
  line-height: 1;
}
.night-day-player .ready-seat-name {
  color: #2a1b00;
  background: var(--secondary);
}
.night-day-player .ready-seat-number {
  color: #f7f2e8;
  background: var(--primary);
}
.night-day-player .ready-seat-note {
  color: var(--secondary);
  min-height: 16px;
}
.night-player-tags {
  min-height: 18px;
  margin-top: 5px;
}
.night-player-empty {
  opacity: 0.62;
}
.night-player-empty .night-seat-frame {
  background: #31352b;
  border-color: rgba(172,184,157,0.24);
  border-bottom-color: #1a1f17;
}
.night-center-piece {
  width: 170px;
  height: 170px;
  color: var(--secondary);
  background: rgba(37,41,35,0.68);
  border-color: rgba(255,223,154,0.14);
  box-shadow: inset 0 20px 40px rgba(0,0,0,0.16), 0 20px 36px rgba(0,0,0,0.2);
}
.night-center-piece strong {
  color: #f7f2e8;
}
.night-center-piece span {
  color: rgba(236,232,220,0.62);
}
.night-player-tags span {
  padding: 2px 6px;
  border-radius: 999px;
  color: #1d1c13;
  background: rgba(255,223,154,0.84);
  font-size: 10px;
  font-weight: 900;
}
.night-player-tags .wolf {
  color: #fff;
  background: var(--primary);
}
.night-player-tags .good {
  color: #102c17;
  background: #b7ccb9;
}
.night-actions {
  min-height: 88px;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 18px;
  margin-top: 8px;
}
.night-action-btn {
  width: 106px;
  min-height: 72px;
  border: 0;
  border-radius: 2px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  color: rgba(236,232,220,0.58);
  background: rgba(37,41,35,0.75);
  box-shadow: 0 16px 30px rgba(0,0,0,0.22);
  font-family: inherit;
  font-weight: 900;
  cursor: pointer;
}
.night-action-btn span {
  width: 34px;
  height: 34px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: #181b17;
  font-size: 20px;
}
.night-action-btn strong {
  font-size: 14px;
}
.night-action-btn.active span {
  background: var(--primary);
}
.night-action-btn.active strong {
  color: #fff;
}
.night-action-btn:disabled {
  opacity: 0.38;
  cursor: not-allowed;
}
.night-curtain-note {
  padding: 18px 30px;
  border: 1px solid rgba(255,223,154,0.14);
  color: rgba(236,232,220,0.66);
  background: rgba(255,255,255,0.04);
  font-weight: 900;
}
.night-result {
  max-width: 620px;
  margin: 8px auto 0;
  padding: 14px 18px;
  border-left: 3px solid var(--primary);
  color: #f7f2e8;
  background: rgba(63,8,11,0.36);
  display: flex;
  gap: 12px;
  align-items: center;
  justify-content: center;
}
.night-result strong {
  color: var(--secondary);
}
.night-right-panel {
  background: #10140f;
}
.night-scroll-panel {
  border-left-color: #2b3229;
  border-right-color: #2b3229;
  color: #ece8dc;
  background: #171b16;
  background-image: radial-gradient(rgba(255,223,154,0.08) 0.55px, transparent 0.55px);
  box-shadow: 0 20px 42px rgba(0,0,0,0.32);
}
.night-scroll-panel .scroll-roll {
  background: #2b3229;
}
.night-scroll-panel h3 {
  color: var(--secondary);
}
.night-scroll-panel .panel-subtitle {
  color: rgba(236,232,220,0.6);
}
.night-scroll-panel .ready-rule-card {
  background: rgba(255,223,154,0.08);
  border-left-color: var(--secondary);
}
.night-scroll-panel .ready-rule-card strong {
  color: var(--secondary);
}
.night-scroll-panel .ready-rule-card span {
  color: rgba(236,232,220,0.72);
}
.night-countdown-panel {
  margin: 0 0 14px;
  padding: 16px 14px;
  border: 1px solid rgba(255,223,154,0.18);
  background: rgba(255,223,154,0.07);
  text-align: center;
}
.night-countdown-panel span {
  display: block;
  color: rgba(236,232,220,0.68);
  font-size: 12px;
  font-weight: 900;
}
.night-countdown-panel strong {
  display: block;
  margin: 4px 0;
  color: var(--secondary);
  font-size: 40px;
  line-height: 1.1;
  font-weight: 1000;
}
.night-countdown-panel p {
  margin: 0;
  color: rgba(236,232,220,0.7);
  font-size: 12px;
  font-weight: 900;
}
.night-side-stats {
  display: grid;
  gap: 12px;
  margin-bottom: 20px;
}
.night-side-stats div {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,223,154,0.1);
}
.night-side-stats span {
  color: rgba(236,232,220,0.62);
  font-size: 12px;
  font-weight: 900;
}
.night-side-stats strong {
  max-width: 148px;
  color: var(--secondary);
  font-size: 13px;
  text-align: right;
}
.night-memo-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
  min-height: 0;
  margin: 0 0 18px;
  overflow-y: auto;
}
.night-memo-item {
  display: grid;
  grid-template-columns: 34px 1fr;
  gap: 10px;
  padding: 12px;
  border: 1px solid rgba(255,223,154,0.1);
  background: rgba(255,255,255,0.035);
}
.night-memo-item span {
  width: 28px;
  height: 28px;
  line-height: 28px;
  color: #f7f2e8;
  background: var(--primary);
  font-size: 12px;
  font-weight: 900;
  text-align: center;
}
.night-memo-item p {
  margin: 0;
  color: rgba(236,232,220,0.78);
  font-size: 13px;
  line-height: 1.6;
  font-weight: 800;
}
.wolf-advice-panel {
  margin: 0 0 18px;
  padding: 14px;
  border: 1px solid rgba(255,223,154,0.16);
  border-left: 4px solid var(--primary);
  background: rgba(99,0,10,0.22);
}
.wolf-advice-panel strong {
  display: block;
  margin-bottom: 10px;
  color: #ffdcc3;
  font-size: 14px;
  font-weight: 900;
}
.wolf-advice-item {
  display: grid;
  grid-template-columns: 64px 1fr;
  gap: 10px;
  padding: 10px 0;
  border-top: 1px solid rgba(255,223,154,0.1);
}
.wolf-advice-item:first-of-type {
  border-top: 0;
}
.wolf-advice-item span {
  color: rgba(236,232,220,0.58);
  font-size: 12px;
  font-weight: 900;
}
.wolf-advice-item p {
  margin: 0;
  color: rgba(236,232,220,0.82);
  font-size: 13px;
  line-height: 1.5;
  font-weight: 800;
}
.wolf-chat-panel {
  margin: 0 0 18px;
  padding: 14px;
  border: 1px solid rgba(255,223,154,0.16);
  border-left: 4px solid #d4237a;
  background: rgba(10,10,12,0.22);
}
.wolf-chat-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 12px;
}
.wolf-chat-title strong {
  color: #ffdcc3;
  font-size: 14px;
  font-weight: 900;
}
.wolf-chat-title button {
  min-height: 32px;
  padding: 0 10px;
  border: 1px solid rgba(255,223,154,0.2);
  border-radius: 4px;
  color: #f7f2e8;
  background: rgba(255,255,255,0.04);
  font-size: 12px;
  font-weight: 900;
  cursor: pointer;
}
.wolf-chat-title button.active {
  border-color: #d4237a;
  color: #fff;
  background: #d4237a;
}
.wolf-chat-list {
  max-height: 150px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 12px;
}
.wolf-chat-item {
  padding: 8px 10px;
  border: 1px solid rgba(255,223,154,0.1);
  background: rgba(255,255,255,0.035);
}
.wolf-chat-item.self {
  border-color: rgba(212,35,122,0.35);
  background: rgba(212,35,122,0.16);
}
.wolf-chat-item span {
  display: block;
  margin-bottom: 4px;
  color: rgba(236,232,220,0.58);
  font-size: 12px;
  font-weight: 900;
}
.wolf-chat-item p {
  margin: 0;
  color: rgba(236,232,220,0.88);
  font-size: 13px;
  line-height: 1.45;
  font-weight: 800;
}
.wolf-chat-input {
  display: grid;
  grid-template-columns: 1fr 36px;
  gap: 8px;
}
.wolf-chat-input .ant-input {
  height: 36px;
  border: 1px solid rgba(255,223,154,0.16);
  border-radius: 4px;
  color: #f7f2e8;
  background: rgba(255,255,255,0.06);
}
.wolf-chat-input button {
  border: 0;
  border-radius: 4px;
  color: #fff;
  background: #d4237a;
  cursor: pointer;
}
.realtime-voice-tip {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 0 0 14px;
  padding: 10px 12px;
  border: 1px solid rgba(84,100,50,0.24);
  border-radius: 4px;
  color: #546432;
  background: rgba(215,234,171,0.24);
  font-size: 13px;
  font-weight: 900;
}
.night-side-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin-top: 18px;
}
.night-side-actions button {
  min-height: 46px;
  border: 1px solid rgba(255,223,154,0.14);
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  color: #f7f2e8;
  background: var(--primary);
  font-family: inherit;
  font-weight: 900;
  cursor: pointer;
}
.night-side-actions button:hover {
  background: #812025;
}
/* ─── Settings Modal ─────────────────────────────────── */
.setting-modal-wrap {
  font-family: Georgia, 'Noto Serif SC', 'Noto Serif', serif;
}
.setting-modal-wrap .ant-modal-content {
  background: #fef9eb !important;
  border: 1px solid rgba(79,52,29,0.28);
  border-radius: 18px;
  overflow: hidden;
  box-shadow: 0 32px 72px rgba(21,14,8,0.32), inset 0 0 0 1px rgba(255,255,255,0.3);
}
.setting-modal-wrap .ant-modal-header {
  background: linear-gradient(180deg, #f2e8d4 0%, #fef9eb 100%) !important;
  border-bottom: 1px solid rgba(91,60,34,0.2) !important;
  padding: 22px 28px 18px;
}
.setting-modal-wrap .ant-modal-title {
  color: #5d261f;
}
.setting-modal-wrap .ant-modal-body {
  background: #fef9eb;
  padding: 20px 28px 10px !important;
}
.setting-modal-wrap .ant-modal-footer {
  background: #fef9eb !important;
  border-top: 1px solid rgba(91,60,34,0.14) !important;
  padding: 14px 28px 22px;
  text-align: center;
}
.setting-modal-wrap .setting-modal-title {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #5d261f;
  font-size: 22px;
  font-weight: 900;
  font-style: italic;
}
.setting-modal-wrap .settings {
  width: 100%;
}
.setting-modal-wrap .setting-cell {
  display: flex;
  align-items: center;
  min-height: 48px;
  padding: 9px 0;
  border-bottom: 1px solid rgba(91,60,34,0.1);
  gap: 12px;
}
.setting-modal-wrap .setting-cell:last-child {
  border-bottom: 0;
}
.setting-modal-wrap .item-title {
  min-width: 0;
  width: 190px;
  flex: none;
  text-align: right !important;
  color: #5d261f;
  font-weight: 800;
  font-size: 13px;
  line-height: 1.4;
  padding-right: 10px;
}
.setting-modal-wrap .fake-input {
  min-width: 56px;
  height: 36px;
  line-height: 36px;
  text-align: center;
  border-radius: 8px;
  border: 1px solid rgba(91,60,34,0.22);
  background: rgba(247,238,221,0.9);
  color: #482400;
  font-size: 17px;
  font-weight: 900;
}
.setting-modal-wrap .icon-font {
  color: #63000a;
  font-size: 21px;
  cursor: pointer;
  opacity: 0.78;
  transition: opacity 0.15s;
}
.setting-modal-wrap .icon-font:hover {
  opacity: 1;
}
.setting-modal-wrap .ant-radio-button-wrapper {
  border-color: rgba(91,60,34,0.28) !important;
  background: rgba(248,243,229,0.9) !important;
  color: #5d261f !important;
  font-family: inherit;
  font-weight: 800;
  font-size: 13px;
}
.setting-modal-wrap .ant-radio-button-wrapper:hover {
  color: #63000a !important;
  border-color: rgba(99,0,10,0.45) !important;
  background: #f8f3e5 !important;
}
.setting-modal-wrap .ant-radio-button-wrapper-checked {
  background: #63000a !important;
  border-color: #63000a !important;
  color: #fff !important;
  box-shadow: -1px 0 0 0 #63000a !important;
}
.setting-modal-wrap .ant-radio-button-wrapper-checked:before {
  background: #63000a !important;
}
.setting-modal-wrap .ant-radio-button-wrapper:not(:first-child)::before {
  background: rgba(91,60,34,0.2) !important;
}
.setting-modal-wrap .btn-primary,
.setting-modal-wrap .btn-primary:hover,
.setting-modal-wrap .btn-primary:focus,
.setting-modal-wrap .btn-primary:after {
  background: #63000a !important;
  border-color: #63000a !important;
  color: #f8efd8 !important;
  min-width: 110px;
  height: 42px;
  border-radius: 8px;
  font-family: inherit;
  font-weight: 900;
  font-size: 15px;
  letter-spacing: 0.04em;
  box-shadow: 0 8px 20px rgba(82,35,28,0.22) !important;
  transition: background 0.18s ease !important;
}
.setting-modal-wrap .btn-primary:hover,
.setting-modal-wrap .btn-primary:focus {
  background: #85171b !important;
  border-color: #85171b !important;
}
/* ─── Vote / Action Modal ────────────────────────────── */
.player-click-modal {
  background-color: #fef9eb;
  font-family: Georgia, 'Noto Serif SC', 'Noto Serif', serif;
}
.player-click-modal .ant-modal-content {
  background: #fef9eb !important;
  border: 1px solid rgba(79,52,29,0.26);
  border-radius: 18px;
  overflow: hidden;
  box-shadow: 0 32px 72px rgba(21,14,8,0.3), inset 0 0 0 1px rgba(255,255,255,0.28);
}
.player-click-modal .ant-modal-header {
  background: linear-gradient(180deg, #f2e8d4 0%, #fef9eb 100%) !important;
  border-bottom: 1px solid rgba(91,60,34,0.18) !important;
  padding: 22px 28px 16px;
}
.player-click-modal .ant-modal-title {
  color: #5d261f;
}
.player-click-modal .action-modal-title {
  display: flex;
  align-items: center;
  gap: 12px;
}
.player-click-modal .action-modal-title .action-title-icon {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
