.welcome-container {
  width: 100%;
  max-width: 500px;
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  color: #1d1c13;
  font-family: Georgia, "Times New Roman", "Noto Serif SC", serif;
  background: #fef9eb;
}
.welcome-container .welcome-bg {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(75,54,33,0.72), rgba(47,29,14,0.42)), url("https://lh3.googleusercontent.com/aida-public/AB6AXuDTprKn8FUcolWLiiCjptxHgZ_mEeN6w98ajveTjSwhHkCavgVAKIeG0i_Sin4W7fSP59-4Ux8MVwY5f485UBfNN42bif9FZhkEr9C3I8ox2bw7gNnIr5LExnyHkjMcBw5I0EQWY_y7ycg2sIftmauVb__nFRaH2KGC8bF8_us5gmrNzkY8miFdLL5H-iQnzGWkIZuxAt7lWkzwrFOG1HprCGQekjWD49xDhCNqUVKrSI7aJykTa8A00WAukSo_rRs3NTCrZ2hUL3o") center/cover;
}
.welcome-container .welcome-mist {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at top, transparent 18%, #fef9eb 78%);
}
.welcome-container .welcome-grain {
  position: absolute;
  inset: 0;
  opacity: 0.06;
  pointer-events: none;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.7' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
}
.welcome-container .welcome-wrap {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  padding: 24px 20px 26px;
  display: flex;
  flex-direction: column;
  gap: 18px;
}
.welcome-container .welcome-hero {
  min-height: 220px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  color: #ffdcc3;
  text-shadow: 0 8px 24px rgba(0,0,0,0.35);
}
.welcome-container .welcome-topline {
  display: flex;
  align-items: center;
  gap: 12px;
}
.welcome-container .welcome-brand-dot {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #63000a;
  background: #ffdcc3;
  font-weight: 900;
}
.welcome-container .welcome-kicker {
  color: rgba(255,220,195,0.8);
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0;
  text-transform: uppercase;
}
.welcome-container h1 {
  margin: 0;
  font-size: 48px;
  line-height: 1;
  font-style: italic;
  font-weight: 900;
  letter-spacing: 0;
}
.welcome-container .welcome-user-panel {
  align-self: flex-start;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 10px 14px;
  border-radius: 999px;
  color: #fef9eb;
  background: rgba(29,28,19,0.32);
  backdrop-filter: blur(12px);
}
.welcome-container .welcome-user-panel span {
  font-size: 12px;
  opacity: 0.85;
}
.welcome-container .welcome-user-panel strong {
  font-size: 16px;
  color: #ffdcc3;
}
.welcome-container .welcome-story {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding: 22px;
  border-radius: 22px;
  background: rgba(254,249,235,0.9);
  box-shadow: 0 24px 56px rgba(29,28,19,0.12);
}
.welcome-container .welcome-chip {
  display: inline-flex;
  margin-bottom: 12px;
  padding: 6px 12px;
  border-radius: 999px;
  color: #63000a;
  background: #ffdcc3;
  font-size: 12px;
  font-weight: 900;
}
.welcome-container .welcome-story-copy h2 {
  margin: 0 0 10px;
  color: #63000a;
  font-size: 31px;
  line-height: 1.15;
  font-weight: 900;
}
.welcome-container .welcome-story-copy p {
  margin: 0;
  color: rgba(29,28,19,0.76);
  font-size: 15px;
  line-height: 1.75;
  font-weight: 600;
}
.welcome-container .welcome-action-panel {
  display: flex;
  flex-direction: column;
  gap: 11px;
}
.welcome-container .welcome-primary-action,
.welcome-container .welcome-secondary-action,
.welcome-container .welcome-admin-action,
.welcome-container .welcome-logout {
  width: 100%;
  min-height: 48px;
  border: 0 !important;
  border-radius: 14px !important;
  font-size: 16px !important;
  font-weight: 900 !important;
  box-shadow: none !important;
}
.welcome-container .welcome-primary-action {
  color: #fff !important;
  background: linear-gradient(135deg, #63000a, #85171b) !important;
}
.welcome-container .welcome-secondary-action {
  color: #5a6a37 !important;
  background: #d7eaab !important;
}
.welcome-container .welcome-admin-action {
  color: #4a3c1d !important;
  background: #fce48d !important;
}
.welcome-container .welcome-log {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 20px;
  border-radius: 18px;
  background: #f8f3e5;
}
.welcome-container .welcome-log h3 {
  margin: 0 0 6px;
  color: #63000a;
  font-size: 24px;
  font-style: italic;
  font-weight: 900;
}
.welcome-container .welcome-log p {
  margin: 0;
  color: rgba(29,28,19,0.68);
  font-size: 13px;
  line-height: 1.6;
  font-weight: 600;
}
.welcome-container .welcome-log-mark {
  flex: 0 0 58px;
  height: 58px;
  border-radius: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fef9eb;
  background: #63000a;
  font-size: 22px;
  font-weight: 900;
  transform: rotate(4deg);
}
.welcome-container .welcome-logout {
  margin-top: auto;
  color: #fff !important;
  background: #f55066 !important;
}
.welcome-container {
  --surface: #fef9eb;
  --surface-low: #f8f3e5;
  --surface-mid: #f3eee0;
  --surface-high: #e7e2d4;
  --primary: #63000a;
  --primary-soft: #ffdad7;
  --primary-deep: #410004;
  --secondary: #546432;
  --secondary-soft: #d7eaab;
  --secondary-deep: #3d4c1d;
  --tertiary: #482400;
  --tertiary-soft: #ffdcc3;
  width: 100%;
  max-width: none;
  min-height: 100vh;
  position: relative;
  overflow-x: hidden;
  overflow-y: visible;
  color: #1d1c13;
  background: var(--surface);
  font-family: Georgia, 'Noto Serif SC', 'Noto Serif', serif;
}
.welcome-container .welcome-bg {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background: none;
}
.welcome-container .welcome-bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.28;
  filter: sepia(0.18) saturate(0.8);
}
.welcome-container .welcome-bg:before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(254,249,235,0.18), rgba(254,249,235,0.52) 42%, rgba(254,249,235,0.96) 100%);
}
.welcome-container .welcome-bg:after {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 50% 0, transparent 18%, rgba(254,249,235,0.88) 86%);
}
.welcome-topbar {
  position: sticky;
  top: 0;
  z-index: 7;
  height: 64px;
  margin-left: 0;
  padding: 0 28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(180deg, rgba(231,226,212,0.82), rgba(254,249,235,0.78));
  backdrop-filter: blur(18px);
  box-shadow: 0 12px 28px rgba(29,28,19,0.06);
}
.welcome-brand {
  color: #2d4b22;
  font-size: 24px;
  line-height: 1;
  font-weight: 900;
  font-style: italic;
}
.welcome-topbar nav {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 34px;
}
.welcome-topbar button,
.welcome-footer button {
  border: 0;
  background: transparent;
  cursor: pointer;
  font-family: inherit;
}
.welcome-topbar nav button {
  padding: 6px 0;
  color: var(--secondary);
  font-size: 15px;
  font-weight: 800;
  font-style: italic;
}
.welcome-topbar nav button.active {
  color: var(--primary);
  border-bottom: 2px solid var(--primary);
}
.welcome-top-actions {
  display: flex;
  align-items: center;
  gap: 14px;
}
.welcome-top-actions button {
  color: var(--primary);
  font-size: 19px;
}
.welcome-account {
  min-height: 34px;
  padding: 0 12px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  border-radius: 999px;
  color: #fff !important;
  background: var(--primary) !important;
  font-size: 13px !important;
  font-weight: 700;
  box-shadow: 0 8px 18px rgba(99,0,10,0.18);
}
.welcome-main {
  position: relative;
  z-index: 2;
  margin-left: 0;
  padding: 44px 24px 88px;
}
.welcome-hero-board {
  display: flex;
  justify-content: center;
  min-height: 238px;
  padding-top: 8px;
}
.wooden-sign {
  position: relative;
  min-width: 380px;
  height: 184px;
  padding: 26px 48px;
  border: 4px solid #3e2b18;
  border-radius: 8px;
  transform: rotate(-1deg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #4b3621, #2f1d0e);
  box-shadow: inset 0 2px 4px rgba(255,255,255,0.1), 0 10px 20px rgba(0,0,0,0.3);
}
.wooden-sign h1 {
  margin: 0;
  color: var(--tertiary-soft);
  font-size: 68px;
  line-height: 1;
  font-weight: 900;
  font-style: italic;
  letter-spacing: 0;
  text-shadow: 0 3px 0 rgba(0,0,0,0.2);
}
.wooden-sign p {
  margin: 14px 0 0;
  color: var(--secondary-soft);
  font-size: 15px;
  font-style: italic;
  font-weight: 700;
}
.sign-rope {
  position: absolute;
  top: -52px;
  width: 4px;
  height: 60px;
  background: rgba(63,63,70,0.48);
}
.sign-rope-left {
  left: 25%;
}
.sign-rope-right {
  right: 25%;
}
.welcome-content-grid,
.history-section {
  width: calc(100vw - 48px);
  max-width: 1280px;
  margin: 0 auto;
}
.welcome-content-grid {
  display: grid;
  grid-template-columns: minmax(0, 7fr) minmax(390px, 5fr);
  gap: 48px;
  align-items: stretch;
}
.storybook-card {
  min-height: 100%;
  padding: 42px 46px 20px;
  display: flex;
  flex-direction: column;
  border-radius: 12px;
  background: rgba(253,246,227,0.96);
  box-shadow: 0 22px 44px rgba(29,28,19,0.13), inset 0 0 0 6px rgba(255,255,255,0.42);
  transform: rotate(1deg);
  overflow: hidden;
}
.storybook-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}
.story-chip {
  width: max-content;
  padding: 4px 13px;
  border-radius: 999px;
  color: #2f1500;
  background: var(--tertiary-soft);
  font-size: 12px;
  font-weight: 800;
}
.storybook-copy h2 {
  margin: 22px 0 16px;
  color: var(--primary);
  font-size: 44px;
  line-height: 1.14;
  font-weight: 900;
}
.storybook-art {
  position: relative;
  height: 238px;
  margin: 0 0 17px;
  border-radius: 0;
  overflow: hidden;
  background: transparent;
  box-shadow: none;
}
.storybook-art:before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
  background: linear-gradient(90deg, rgba(253,246,227,0.98) 0%, rgba(253,246,227,0.58) 4%, rgba(253,246,227,0) 12%, rgba(253,246,227,0) 88%, rgba(253,246,227,0.58) 96%, rgba(253,246,227,0.98) 100%), linear-gradient(180deg, rgba(253,246,227,0.98) 0%, rgba(253,246,227,0.5) 5%, rgba(253,246,227,0) 13%, rgba(253,246,227,0) 76%, rgba(253,246,227,0.62) 91%, rgba(253,246,227,0.98) 100%);
}
.story-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 12px;
}
.story-body p {
  margin: 0;
  color: rgba(29,28,19,0.82);
  font-size: 15px;
  line-height: 1.62;
}
.wisdom-note {
  margin-top: 18px;
  padding-top: 0;
  display: flex;
  align-items: center;
  gap: 14px;
}
.wisdom-icon {
  width: 50px;
  height: 50px;
  flex: 0 0 50px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--secondary-deep);
  background: var(--secondary-soft);
}
.wisdom-note strong {
  display: block;
  color: #1d1c13;
  font-size: 14px;
  line-height: 1.3;
}
.wisdom-note span {
  display: block;
  margin-top: 2px;
  color: #43483f;
  font-size: 12px;
}
.storybook-art img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 38%;
  transform: scale(1.012);
}
.lobby-card-stack {
  display: flex;
  flex-direction: column;
  gap: 24px;
}
.lobby-card {
  position: relative;
  padding: 26px 30px 30px;
  min-height: 190px;
  border-radius: 12px;
  overflow: hidden;
  background: rgba(248,243,229,0.92);
  box-shadow: 0 14px 30px rgba(29,28,19,0.12);
}
.lobby-card:after {
  content: '';
  position: absolute;
  width: 142px;
  height: 142px;
  right: -70px;
  top: -70px;
  border-radius: 50%;
  background: rgba(99,0,10,0.05);
}
.join-card {
  border-left: 8px solid var(--primary);
}
.create-card {
  border-left: 8px solid var(--secondary);
  background: rgba(231,226,212,0.9);
}
.observe-card {
  border-left: 8px solid var(--tertiary);
}
.card-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 18px;
}
.card-icon {
  width: 54px;
  height: 54px;
  border-radius: 12px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  color: var(--primary-deep);
  background: var(--primary-soft);
}
.create-card .card-icon {
  color: var(--secondary-deep);
  background: var(--secondary-soft);
}
.observe-card .card-icon {
  color: var(--tertiary);
  background: var(--tertiary-soft);
}
.card-kicker {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: var(--primary);
  font-size: 18px;
  font-weight: 900;
  font-style: italic;
}
.create-card .card-kicker {
  color: var(--secondary);
}
.observe-card .card-kicker {
  color: var(--tertiary);
}
.lobby-card h3 {
  position: relative;
  z-index: 1;
  margin: 0 0 10px;
  font-size: 25px;
  line-height: 1.2;
  font-weight: 900;
}
.lobby-card p {
  position: relative;
  z-index: 1;
  margin: 0 0 22px;
  color: #43483f;
  font-size: 13px;
  line-height: 1.7;
}
.action-row {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 10px;
}
.action-row.single {
  margin-bottom: 12px;
}
.action-row input {
  min-width: 0;
  flex: 1;
  height: 48px;
  padding: 0 14px;
  border: 0;
  border-radius: 8px;
  outline: none;
  color: #1d1c13;
  background: var(--surface-high);
  font-family: inherit;
}
.action-row input:focus {
  box-shadow: 0 0 0 3px rgba(99,0,10,0.14);
}
.primary-button {
  position: relative;
  z-index: 1;
  min-height: 48px;
  padding: 0 22px;
  border: 0;
  border-radius: 10px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  color: #fff;
  font-family: inherit;
  font-weight: 900;
  cursor: pointer;
  box-shadow: 0 10px 18px rgba(29,28,19,0.16);
  transition: transform 0.18s ease, opacity 0.18s ease;
}
.primary-button:hover {
  transform: translateY(-1px);
}
.primary-button:disabled {
  opacity: 0.58;
  cursor: not-allowed;
  transform: none;
}
.red-button {
  background: linear-gradient(135deg, var(--primary), #85171b);
}
.green-button {
  background: var(--secondary);
}
.olive-button {
  background: var(--tertiary);
}
.full-button {
  width: 100%;
}
.history-section {
  margin-top: 78px;
}
.history-heading {
  display: flex;
  align-items: center;
  gap: 26px;
  margin-bottom: 24px;
}
.history-heading h2 {
  margin: 0;
  color: var(--primary);
  font-size: 32px;
  line-height: 1;
  font-weight: 900;
  font-style: italic;
}
.history-heading span {
  height: 2px;
  flex: 1;
  background: linear-gradient(90deg, rgba(99,0,10,0.2), transparent);
}
.history-heading em {
  color: var(--secondary);
  font-size: 13px;
  font-weight: 900;
  font-style: normal;
}
.history-scroll {
  display: flex;
  gap: 24px;
  overflow-x: auto;
  padding: 6px 8px 24px;
  scrollbar-width: none;
}
.history-scroll::-webkit-scrollbar {
  display: none;
}
.history-card {
  min-width: 320px;
  min-height: 206px;
  padding: 24px;
  border: 0;
  display: flex;
  flex-direction: column;
  gap: 16px;
  border-top: 4px solid var(--surface-high);
  border-radius: 8px;
  color: inherit;
  background: var(--surface-low);
  box-shadow: 0 10px 22px rgba(29,28,19,0.11);
  cursor: pointer;
  font-family: inherit;
  text-align: left;
  transition: opacity 0.18s ease, transform 0.18s ease;
}
.history-card.rotate-0 {
  transform: rotate(1deg);
}
.history-card.rotate-1 {
  transform: rotate(-1deg);
}
.history-card.rotate-2 {
  transform: rotate(2deg);
}
.history-card.rotate-3 {
  transform: rotate(-2deg);
}
.history-card:hover {
  opacity: 0.92;
}
.history-card:disabled {
  cursor: not-allowed;
  opacity: 0.62;
}
.history-meta {
  display: flex;
  justify-content: space-between;
  color: rgba(29,28,19,0.6);
  font-size: 12px;
}
.history-card p {
  margin: 0;
  flex: 1;
  font-size: 16px;
  line-height: 1.55;
}
.history-role-line {
  display: flex;
  justify-content: space-between;
  gap: 14px;
  color: rgba(29,28,19,0.66);
  font-size: 12px;
  font-weight: 800;
}
.history-result {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.history-dots {
  display: flex;
  margin-left: 8px;
}
.history-dots span {
  width: 28px;
  height: 28px;
  margin-left: -8px;
  border: 2px solid var(--surface);
  border-radius: 50%;
}
.history-result strong {
  padding: 4px 12px;
  border-radius: 999px;
  font-size: 10px;
  line-height: 1.2;
  font-weight: 900;
}
.result-danger {
  color: #93000a;
  background: #ffdad6;
}
.result-success {
  color: var(--secondary-deep);
  background: var(--secondary-soft);
}
.result-neutral {
  color: #6e3900;
  background: var(--tertiary-soft);
}
.history-empty {
  min-width: 320px;
  min-height: 206px;
  padding: 24px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(29,28,19,0.58);
  background: rgba(248,243,229,0.72);
  font-size: 14px;
  font-weight: 900;
}
.welcome-replay-modal .replay-loading {
  padding: 30px 0;
  color: #43483f;
  text-align: center;
  font-weight: 900;
}
.welcome-replay-modal .replay-detail {
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.welcome-replay-modal .replay-detail-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.welcome-replay-modal .replay-detail-meta span,
.welcome-replay-modal .replay-player-list span {
  padding: 5px 10px;
  border-radius: 999px;
  color: var(--primary);
  background: rgba(255,218,215,0.58);
  font-size: 12px;
  font-weight: 900;
}
.welcome-replay-modal .replay-player-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.welcome-replay-modal .replay-player-list span {
  color: var(--secondary-deep);
  background: rgba(215,234,171,0.66);
}
.welcome-replay-modal .replay-text {
  max-height: 440px;
  margin: 0;
  padding: 16px;
  overflow: auto;
  border-radius: 8px;
  color: #2f2416;
  background: #f8f3e5;
  white-space: pre-wrap;
  font-size: 13px;
  line-height: 1.7;
  font-family: inherit;
}
.welcome-replay-modal .replay-close-button {
  min-height: 34px;
  padding: 0 18px;
}
.welcome-footer {
  position: relative;
  z-index: 2;
  margin-left: 0;
  padding: 34px 28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  color: #43483f;
  background: rgba(231,226,212,0.52);
  border-top: 1px solid var(--surface-high);
}
.welcome-footer strong {
  color: var(--primary);
  font-size: 20px;
  font-style: italic;
}
.welcome-footer div {
  display: flex;
  gap: 32px;
}
.welcome-footer button {
  color: #1d1c13;
}
.welcome-footer span {
  color: rgba(67,72,63,0.7);
  font-style: italic;
}
@media (max-width: 1180px) {
  .welcome-content-grid {
    grid-template-columns: 1fr;
  }
  .lobby-card-stack {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .storybook-card {
    padding: 34px;
  }
  .storybook-art {
    height: 220px;
  }
}
@media (max-width: 920px) {
  .welcome-topbar,
  .welcome-main,
  .welcome-footer {
    margin-left: 0;
  }
  .welcome-topbar {
    padding: 0 16px;
  }
  .welcome-topbar nav {
    display: none;
  }
  .welcome-content-grid,
  .history-section {
    width: calc(100vw - 32px);
  }
  .storybook-card {
    padding: 28px;
  }
  .storybook-art {
    height: 190px;
  }
  .lobby-card-stack {
    grid-template-columns: 1fr;
  }
  .welcome-footer {
    flex-direction: column;
    text-align: center;
  }
}
@media (max-width: 560px) {
  .welcome-main {
    padding: 28px 16px 64px;
  }
  .welcome-hero-board {
    min-height: 186px;
  }
  .wooden-sign {
    min-width: 0;
    width: 100%;
    height: auto;
    padding: 24px 20px;
  }
  .wooden-sign h1 {
    font-size: 46px;
  }
  .action-row {
    flex-direction: column;
  }
  .primary-button {
    width: 100%;
  }
  .history-heading {
    gap: 12px;
  }
  .history-heading h2 {
    font-size: 26px;
  }
}