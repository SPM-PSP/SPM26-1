  background: #5d261f;
  box-shadow: 0 5px 14px rgba(82,35,28,0.24);
}
.player-click-modal .action-modal-title .action-title-icon svg {
  font-size: 22px;
}
.player-click-modal .action-modal-title strong {
  display: block;
  color: #5d261f;
  font-size: 21px;
  line-height: 28px;
  font-weight: 900;
  font-style: italic;
}
.player-click-modal .action-modal-title span {
  display: block;
  margin-top: 2px;
  color: #74634d;
  font-size: 13px;
  line-height: 18px;
  font-weight: 800;
}
.player-click-modal .hunter-action-title .action-title-icon {
  color: #ffdfac;
  background: #7a4200;
}
.player-click-modal .ant-modal-body {
  background: #fef9eb !important;
  padding: 20px 22px 18px !important;
}
.player-click-modal .ant-modal-footer {
  background: #fef9eb !important;
  border-top: 1px solid rgba(91,60,34,0.14) !important;
  padding: 14px 28px 22px;
  text-align: center;
}
.player-click-modal .btn-primary,
.player-click-modal .btn-primary:hover,
.player-click-modal .btn-primary:focus,
.player-click-modal .btn-primary:after {
  background: #63000a !important;
  border-color: #63000a !important;
  color: #f8efd8 !important;
  min-width: 100px;
  height: 40px;
  border-radius: 8px;
  font-family: inherit;
  font-weight: 900;
  box-shadow: 0 6px 18px rgba(82,35,28,0.2) !important;
  transition: background 0.18s ease !important;
}
.player-click-modal .btn-primary:hover,
.player-click-modal .btn-primary:focus {
  background: #85171b !important;
  border-color: #85171b !important;
}
.player-click-modal .content-wrap {
  width: 100%;
}
.player-click-modal .content-wrap .action-brief {
  margin-bottom: 14px;
  padding: 13px 16px;
  border: 1px solid rgba(91,60,34,0.16);
  border-left: 4px solid #7a4200;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  background: rgba(232,214,189,0.42);
  color: #5d261f;
}
.player-click-modal .content-wrap .action-brief strong {
  display: block;
  font-size: 15px;
  line-height: 20px;
  font-weight: 900;
}
.player-click-modal .content-wrap .action-brief span {
  display: block;
  margin-top: 3px;
  color: #6f5c45;
  font-size: 13px;
  line-height: 18px;
  font-weight: 800;
}
.player-click-modal .content-wrap .action-brief em {
  flex: none;
  min-width: 92px;
  height: 30px;
  padding: 0 12px;
  border-radius: 15px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #f8efd8;
  background: #5d261f;
  font-size: 12px;
  line-height: 30px;
  font-style: normal;
  font-weight: 900;
}
.player-click-modal .content-wrap .content-view {
  border-radius: 12px;
  border: 1px solid rgba(91,60,34,0.14);
  background: rgba(243,236,218,0.5);
  overflow: auto;
  max-height: 380px;
  margin: 0;
  padding: 16px 14px;
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  justify-content: center;
  scrollbar-width: thin;
  scrollbar-color: rgba(99,0,10,0.2) transparent;
}
.player-click-modal .content-wrap .player-cell {
  width: 152px;
  min-height: 178px;
  margin: 0;
  border-radius: 12px;
  border: 2px solid rgba(91,60,34,0.18);
  background: rgba(254,249,235,0.95);
  box-shadow: 0 6px 18px rgba(29,28,19,0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5px;
  padding: 13px 10px 12px;
  position: relative;
  transition: box-shadow 0.18s, border-color 0.18s, background 0.18s;
