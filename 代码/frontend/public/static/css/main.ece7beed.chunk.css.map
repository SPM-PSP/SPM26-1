.room-container {
  width: 100%;
  height: 100%;
  background-color: #fff;
  position: relative;
}
.room-container .title-text {
  width: 100%;
  font-size: 16px;
  font-weight: bold;
  text-align: center;
}
.room-container .full-btn {
  width: 100%;
}
.room-container .room-wrap {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}
.room-container .room-wrap .btn-record {
  position: fixed;
  bottom: 80px;
  font-size: 14px;
  font-weight: bold;
  height: 80px;
  width: 80px;
  border-radius: 40px;
  text-align: center;
  line-height: 80px;
  cursor: pointer;
  left: calc(50% + 150px);
}
.room-container .room-wrap .btn-refresh {
  position: fixed;
  bottom: 80px;
  font-size: 14px;
  font-weight: bold;
  height: 80px;
  width: 80px;
  border-radius: 40px;
  text-align: center;
  line-height: 80px;
  cursor: pointer;
  left: 50%;
  transform: translateX(-50%);
}
.room-container .room-wrap .btn-next-stage {
  position: fixed;
  bottom: 80px;
  font-size: 14px;
  font-weight: bold;
  height: 80px;
  width: 80px;
  border-radius: 40px;
  text-align: center;
  line-height: 80px;
  cursor: pointer;
  left: calc(50% - 230px);
}
.error-view {
  width: 100%;
}
.error-view .desc {
  font-size: 16px;
  font-weight: 500;
  text-align: center;
}
/* .player-click-modal – full theme defined near bottom of file */
.game-record-modal {
  font-family: Georgia, 'Noto Serif SC', 'Noto Serif', serif;
}
.game-record-modal .ant-modal-content {
  background: #e5d7bd !important;
  border: 1px solid rgba(79,52,29,0.34);
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 24px 70px rgba(21,14,8,0.34), inset 0 0 0 1px rgba(255,255,255,0.36);
}
.game-record-modal .ant-modal-header {
  background: linear-gradient(180deg, #f1e8d6 0%, #e5d7bd 100%) !important;
  border-bottom: 1px solid rgba(91,60,34,0.22) !important;
  padding: 22px 26px 16px;
}
.game-record-modal .ant-modal-title {
  color: #5d261f;
}
.game-record-modal .ant-modal-body {
  background: #e5d7bd;
  padding: 0 0 18px !important;
}
.game-record-modal .ant-modal-footer {
  background: #e5d7bd !important;
  border-top: 1px solid rgba(91,60,34,0.18) !important;
  padding: 14px 26px 20px;
}
.game-record-modal .btn-primary {
  min-width: 96px;
  height: 38px;
  border-radius: 4px;
  color: #f8efd8 !important;
  background: #5d261f !important;
  border-color: #5d261f !important;
  font-weight: 700;
  letter-spacing: 0;
  box-shadow: 0 5px 14px rgba(82,35,28,0.22) !important;
}
.game-record-modal .game-record-modal-title {
  display: flex;
  align-items: center;
  gap: 12px;
  color: #5d261f;
}
.game-record-modal .game-record-modal-title svg {
  font-size: 24px;
  padding: 8px;
  width: 42px;
  height: 42px;
  border-radius: 50%;
  color: #efe5cd;
  background: #5d261f;
  box-shadow: 0 4px 12px rgba(77,42,25,0.24);
}
.game-record-modal .game-record-modal-title strong {
  display: block;
  font-size: 22px;
  line-height: 28px;
  letter-spacing: 0;
}
.game-record-modal .game-record-modal-title span {
  display: block;
  margin-top: 2px;
  color: #75654f;
  font-size: 13px;
  line-height: 18px;
  font-weight: 600;
}
.role-card-wrap .card-img {
  width: 100%;
  height: auto;
}
.ant-modal-confirm-content {
  margin-left: 0 !important;
}
.winner-wrap {
  width: 100%;
}
.winner-wrap .img-card-wrap {
  position: relative;
}
.winner-wrap .img-card-wrap img {
  width: 80%;
  height: auto;
}
.winner-wrap .img-card-wrap .winner-mask {
  position: absolute;
  width: 80%;
  height: 100%;
  left: 10%;
  top: 0;
  background-color: #000;
  opacity: 0.5;
}
.winner-wrap .img-card-wrap .winner-mask-text-wrap {
  position: absolute;
  width: 80%;
  height: 100%;
  left: 10%;
  top: 0;
}
.winner-wrap .img-card-wrap .winner-mask-text-wrap img {
  width: 64px;
  height: 64px;
}
.winner-wrap .img-card-wrap .winner-mask-text-wrap .txt {
  text-align: center;
  color: #fff;
  font-weight: bold;
  font-size: 20px;
  line-height: 100%;
}
.winner-title {
  font-size: 18px;
}
.mock-settlement-tools {
  position: fixed;
  left: 18px;
  bottom: 18px;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 10px;
  border: 1px solid rgba(122,0,11,0.18);
  border-radius: 4px;
  background: rgba(254,249,235,0.94);
  box-shadow: 0 12px 28px -18px rgba(29,28,19,0.45);
  font-family: Georgia, 'Noto Serif SC', 'Noto Serif', serif;
}
.mock-settlement-tools span {
  color: #5a4b32;
  font-size: 12px;
  font-weight: 700;
}
.mock-settlement-tools button {
  height: 28px;
  padding: 0 12px;
  border: 0;
  border-radius: 3px;
  color: #fff;
  background: #63000a;
  font-size: 12px;
  font-weight: 800;
  cursor: pointer;
}
.mock-settlement-tools button:last-child {
  background: #2d6a4f;
}
.room-sync-shell {
  min-height: 100vh;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1d1c13;
  background: radial-gradient(circle at 50% 38%, #fffdf4 0%, #f8f3e5 44%, #e7e2d4 100%);
  font-family: Georgia, 'Noto Serif SC', 'Noto Serif', serif;
}
.room-sync-brand {
  position: absolute;
  left: 30px;
  top: 24px;
  color: #2d4b22;
  font-size: 26px;
  font-weight: 900;
  font-style: italic;
}
.room-sync-card {
  min-width: 300px;
  padding: 50px 62px 46px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
  border: 1px solid rgba(99,0,10,0.1);
  border-radius: 10px;
  background: rgba(254,249,235,0.92);
  box-shadow: 0 24px 70px -46px rgba(41,27,14,0.6);
}
.room-sync-card h2 {
  margin: 8px 0 0;
  color: #482400;
  font-size: 22px;
  font-weight: 900;
}
.room-sync-card p {
  margin: 0;
  color: #6d6251;
  font-size: 14px;
}
.room-sync-spinner {
  width: 40px;
  height: 40px;
  display: block;
  border: 3px solid rgba(99,0,10,0.12);
  border-top-color: #63000a;
  border-radius: 50%;
  animation: room-sync-spin 0.85s linear infinite;
}
.room-ready-shell {
  --surface: #fef9eb;
  --surface-low: #f8f3e5;
  --surface-mid: #f3eee0;
  --surface-high: #e7e2d4;
  --primary: #63000a;
  --primary-dark: #410004;
  --secondary: #546432;
  --secondary-soft: #d7eaab;
  --tertiary: #482400;
  --tertiary-soft: #ffdcc3;
  width: 100%;
  height: 100vh;
  min-height: 680px;
  display: grid;
  grid-template-columns: 256px minmax(720px, 1fr) 340px;
  grid-template-rows: 76px minmax(0, 1fr);
  position: relative;
  overflow-x: auto;
  overflow-y: hidden;
  color: #1d1c13;
  background: var(--surface);
  font-family: Georgia, 'Noto Serif SC', 'Noto Serif', serif;
}
.ready-bg {
  position: fixed;
  inset: 76px 340px 0 256px;
  z-index: 0;
  pointer-events: none;
  background: var(--surface-low);
  overflow: hidden;
}
.ready-bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.3;
  filter: sepia(0.08) saturate(0.85);
}
.ready-bg:after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(0deg, rgba(254,249,235,0.88), rgba(254,249,235,0.42) 34%, rgba(254,249,235,0.18) 68%, rgba(254,249,235,0.72));
}
.ready-topbar {
  grid-column: 1/4;
  grid-row: 1;
  z-index: 5;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30px;
  background: linear-gradient(180deg, rgba(231,226,212,0.82), rgba(254,249,235,0.88));
  box-shadow: 0 10px 30px -18px rgba(29,28,19,0.28);
}
.ready-brand {
  color: #2d4b22;
  font-size: 26px;
  font-weight: 900;
  font-style: italic;
}
.ready-topbar nav {
  display: flex;
  gap: 30px;
  margin-left: 28px;
  margin-right: auto;
}
.ready-topbar button {
  border: 0;
  background: transparent;
  color: var(--secondary);
  cursor: pointer;
  font-family: inherit;
  font-size: 16px;
  font-weight: 900;
  font-style: italic;
}
.ready-room-plaque {
  position: absolute;
  left: 50%;
  bottom: -18px;
  transform: translateX(-50%);
  min-width: 150px;
  padding: 9px 22px 12px;
  border-radius: 8px;
  border-bottom: 4px solid #2f1500;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--tertiary);
  box-shadow: 0 12px 24px rgba(29,28,19,0.22);
}
.ready-room-plaque span {
  color: var(--tertiary-soft);
  font-size: 10px;
  font-weight: 900;
}
.ready-room-plaque strong {
  color: #fff;
  font-size: 22px;
  line-height: 1.1;
}
.ready-sidebar {
  grid-column: 1;
  grid-row: 2;
  z-index: 3;
  min-height: 0;
  padding: 26px 30px 24px;
  display: flex;
  flex-direction: column;
  gap: 24px;
  background: var(--surface-low);
  border-radius: 0 30px 0 0;
  box-shadow: 22px 0 42px rgba(29,28,19,0.08);
}
.ready-narrator {
  display: flex;
  align-items: center;
  gap: 14px;
}
.ready-narrator img {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  border: 2px solid var(--primary);
  object-fit: cover;
}
.ready-narrator img.identity-portrait {
  object-position: center 18%;
}
.ready-narrator-portrait {
  width: 56px;
  height: 56px;
  flex: none;
  overflow: hidden;
  border: 2px solid var(--primary);
  border-radius: 50%;
  background: #fff;
}
.ready-narrator-portrait img {
  width: 100%;
  height: 100%;
  border: 0;
  border-radius: 0;
  object-fit: cover;
}
.ready-narrator-portrait img.identity-portrait {
  object-position: center 15%;
  transform: scale(1.3);
  transform-origin: center 22%;
}
.ready-narrator strong {
  display: block;
  color: var(--primary);
  font-size: 18px;
}
.ready-narrator span {
  display: block;
  color: var(--secondary);
  font-size: 12px;
  line-height: 1.4;
}
.ready-sidebar nav {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.ready-sidebar nav button,
.ready-side-link {
  min-height: 44px;
  border: 0;
  border-radius: 12px;
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 0 12px;
  color: rgba(90,106,55,0.76);
  background: transparent;
  cursor: pointer;
  font-family: inherit;
  font-size: 14px;
  font-weight: 800;
  text-align: left;
}
.ready-sidebar nav button.active,
.ready-sidebar nav button:hover,
.ready-side-link:hover {
  color: var(--primary);
  background: rgba(231,226,212,0.72);
}
.ready-summary {
  display: grid;
  gap: 10px;
  padding: 16px;
  border-radius: 14px;
  background: rgba(254,249,235,0.74);
  border: 1px solid rgba(231,226,212,0.8);
}
.ready-summary div {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #43483f;
  font-size: 12px;
}
.ready-summary strong {
  color: var(--primary);
  font-size: 15px;
}
.ready-start-btn {
  min-height: 58px;
  border: 0;
  border-radius: 14px;
  color: #fff;
  background: linear-gradient(135deg, var(--primary), #85171b);
  box-shadow: 0 16px 26px rgba(99,0,10,0.2);
  font-family: inherit;
  font-size: 18px;
  font-weight: 900;
  cursor: pointer;
}
.ready-start-btn:disabled {
  opacity: 0.48;
  cursor: not-allowed;
}
.ready-end-btn {
  min-height: 52px;
  border: 2px solid var(--primary);
  border-radius: 14px;
  color: var(--primary);
  background: rgba(254,249,235,0.7);
  font-family: inherit;
  font-size: 17px;
  font-weight: 900;
  cursor: pointer;
}
.ready-end-btn:hover {
  color: #fff;
  background: var(--primary);
}
.ready-side-link {
  margin-top: auto;
}
.ready-rules-modal {
  font-family: Georgia, 'Noto Serif SC', 'Noto Serif', serif;
}
.ready-rules-modal .ant-modal-content {
  overflow: hidden;
  border-radius: 22px;
  background: #fef9eb;
  box-shadow: 0 28px 70px rgba(42,26,17,0.28);
}
.ready-rules-modal .ant-modal-header {
  padding: 24px 30px 10px;
  border-bottom: 0;
  background: linear-gradient(180deg, #fff8ea, #fef9eb);
}
.ready-rules-modal .ant-modal-body {
  padding: 0 30px 24px;
  background: #fef9eb;
}
.ready-rules-modal .ant-modal-footer {
  padding: 14px 30px 24px;
  border-top: 0;
  background: #fef9eb;
}
.ready-rules-title {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--primary);
  font-size: 24px;
  font-weight: 900;
  font-style: italic;
}
.ready-rules-shell {
  max-height: 68vh;
  overflow-y: auto;
  padding-right: 8px;
  scrollbar-width: thin;
  scrollbar-color: rgba(99,0,10,0.2) transparent;
}
.ready-rules-brief {
  margin: 0 0 18px;
  padding: 13px 18px;
  border-left: 4px solid #63000a;
  border-radius: 0 10px 10px 0;
  background: rgba(231,226,212,0.55);
}
.ready-rules-brief strong {
  display: block;
  color: #63000a;
  font-size: 15px;
  line-height: 1.5;
}
.ready-rules-brief span {
  display: block;
  margin-top: 4px;
  color: #5e583d;
  font-size: 13px;
  line-height: 1.65;
}
/* section card layout */
.rr-preamble {
  margin: 0 0 14px;
  color: #342c20;
  font-size: 14px;
  line-height: 1.8;
}
.rr-preamble h1 {
  display: none;
}
.rr-section {
  margin: 0 0 16px;
  border: 1px solid rgba(99,0,10,0.15);
  border-radius: 12px;
  overflow: hidden;
  background: rgba(254,249,235,0.65);
  box-shadow: 0 4px 16px rgba(29,28,19,0.07);
}
.rr-section-title {
  margin: 0;
  padding: 13px 20px 12px;
  color: #4d2811;
  background: linear-gradient(120deg, rgba(231,226,212,0.92), rgba(243,238,224,0.82));
  border-bottom: 1px solid rgba(99,0,10,0.1);
  font-size: 17px;
  font-weight: 900;
  line-height: 1.3;
}
.rr-section-body {
  padding: 14px 20px 16px;
  color: #342c20;
  font-size: 13.5px;
  line-height: 1.82;
}
.rr-section-body h3 {
  margin: 16px 0 7px;
  padding-bottom: 7px;
  border-bottom: 1px solid rgba(99,0,10,0.12);
  color: #63000a;
  font-size: 15px;
  font-weight: 900;
}
.rr-section-body h3:first-child {
  margin-top: 4px;
}
.rr-section-body h4 {
  margin: 13px 0 5px;
  padding-left: 10px;
  border-left: 3px solid #546432;
  color: #3d4c1d;
  font-size: 13.5px;
  font-weight: 900;
}
.rr-section-body p {
  margin: 0 0 8px;
}
.rr-section-body ul {
  margin: 4px 0 10px;
  padding: 10px 14px 10px 30px;
  border-radius: 8px;
  background: rgba(255,255,255,0.5);
  border: 1px solid rgba(231,226,212,0.8);
}
.rr-section-body li {
  margin: 4px 0;
  color: #342c20;
}
.ready-rules-divider {
  height: 1px;
  margin: 12px 0;
  background: linear-gradient(90deg, transparent, rgba(99,0,10,0.22), transparent);
}
.rr-step {
  display: grid;
  grid-template-columns: 24px 1fr;
  align-items: flex-start;
  gap: 11px;
  margin: 5px 0;
  padding: 9px 14px;
  border-radius: 8px;
  background: rgba(248,243,229,0.72);
  border: 1px solid rgba(231,226,212,0.72);
  font-size: 13.5px;
  line-height: 1.7;
  color: #342c20;
}
.rr-step-num {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  flex: none;
  border-radius: 50%;
  color: #fff;
  background: #63000a;
  font-size: 12px;
  font-weight: 900;
  margin-top: 2px;
}
.ready-main {
  grid-column: 2;
  grid-row: 2;
  z-index: 2;
  min-width: 0;
  min-height: 0;
  overflow-y: auto;
  padding: 22px 30px 18px;
}
.ready-square-card {
  position: relative;
  min-height: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
}
.ready-status-banner {
  min-width: 390px;
  padding: 12px 44px;
  border: 3px solid var(--secondary);
  border-radius: 999px;
  background: rgba(215,234,171,0.92);
  text-align: center;
  box-shadow: 0 18px 36px rgba(29,28,19,0.12);
}
.ready-status-banner h2 {
  margin: 0;
  color: var(--secondary);
  font-size: 30px;
  line-height: 1.1;
  font-weight: 900;
  letter-spacing: 0.16em;
}
.ready-status-banner p {
  margin: 6px 0 0;
  color: #3d4c1d;
  font-size: 13px;
}
.ready-orbit {
  position: relative;
  width: 100%;
  flex: 1;
  min-height: 480px;
  margin: 10px 0 8px;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  grid-template-rows: repeat(3, 1fr);
  gap: 28px 16px;
  align-items: center;
  justify-items: center;
}
.ready-seat-card {
  position: relative;
  transform: none;
  width: 112px;
  border: 0;
  background: transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  cursor: pointer;
  font-family: inherit;
}
.ready-seat-slot {
  position: static;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 0;
}
.ready-seat-slot-1 {
  grid-column: 1;
  grid-row: 1;
}
.ready-seat-slot-2 {
  grid-column: 2;
  grid-row: 1;
}
.ready-seat-slot-3 {
  grid-column: 3;
  grid-row: 1;
}
.ready-seat-slot-4 {
  grid-column: 4;
  grid-row: 1;
}
.ready-seat-slot-5 {
  grid-column: 5;
  grid-row: 1;
}
.ready-seat-slot-6 {
  grid-column: 1;
  grid-row: 2;
}
.ready-seat-slot-7 {
  grid-column: 5;
  grid-row: 2;
}
.ready-seat-slot-8 {
  grid-column: 1;
  grid-row: 3;
}
.ready-seat-slot-9 {
  grid-column: 2;
  grid-row: 3;
}
.ready-seat-slot-10 {
  grid-column: 3;
  grid-row: 3;
}
.ready-seat-slot-11 {
  grid-column: 4;
  grid-row: 3;
}
.ready-seat-slot-12 {
  grid-column: 5;
  grid-row: 3;
}
.ready-seat-slot-1 .ready-seat-frame,
.ready-seat-slot-5 .ready-seat-frame,
.ready-seat-slot-10 .ready-seat-frame {
  transform: rotate(-4deg);
}
.ready-seat-slot-2 .ready-seat-frame,
.ready-seat-slot-8 .ready-seat-frame,
.ready-seat-slot-12 .ready-seat-frame {
  transform: rotate(3deg);
}
.ready-seat-slot-3 .ready-seat-frame,
.ready-seat-slot-6 .ready-seat-frame,
.ready-seat-slot-11 .ready-seat-frame {
  transform: rotate(2deg);
}
.ready-seat-slot-4 .ready-seat-frame,
.ready-seat-slot-7 .ready-seat-frame,
.ready-seat-slot-9 .ready-seat-frame {
  transform: rotate(-2deg);
}
.ready-seat-frame {
  position: relative;
  width: 82px;
  height: 82px;
  padding: 7px;
  border-radius: 12px;
  background: var(--tertiary);
  border-bottom: 5px solid #2f1500;
  box-shadow: 0 18px 32px rgba(47,21,0,0.24);
  transform: rotate(-4deg);
  transition: transform 0.2s ease;
}
.ready-seat-card:hover .ready-seat-frame {
  transform: scale(1.05) rotate(0deg);
}
.ready-seat-frame img,
.ready-seat-placeholder {
  width: 100%;
  height: 100%;
  border: 2px solid var(--tertiary-soft);
  border-radius: 7px;
  object-fit: cover;
  background: #fff;
}
.ready-seat-frame img.identity-portrait {
  object-position: center 18%;
}
.ready-seat-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(72,36,0,0.42);
  background: rgba(254,249,235,0.84);
  font-size: 28px;
}
.ready-seat-number {
  position: absolute;
  left: 50%;
  top: -11px;
  transform: translateX(-50%);
  min-width: 42px;
  padding: 2px 8px;
  border-radius: 999px;
  color: #fff;
  background: var(--primary);
  font-size: 11px;
  font-weight: 900;
}
.ready-seat-name {
  margin-top: 7px;
  max-width: 130px;
  padding: 3px 10px;
  border-radius: 4px;
  color: #fff;
  background: var(--primary);
  font-size: 12px;
  line-height: 1.3;
  font-weight: 900;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.ready-seat-note {
  margin-top: 4px;
  color: var(--secondary);
  font-size: 11px;
  font-weight: 800;
}
.ready-seat-empty .ready-seat-frame {
  background: rgba(72,36,0,0.46);
  border-bottom-color: rgba(47,21,0,0.58);
}
.ready-seat-empty .ready-seat-name {
  color: var(--primary);
  background: var(--tertiary-soft);
}
.ready-seat-reserve {
  opacity: 0.74;
}
.ready-seat-kick .ready-seat-frame {
  background: #85171b;
  border-bottom-color: var(--primary-dark);
}
.ready-day-player {
  cursor: default;
  z-index: 3;
}
.ready-day-player .ready-seat-name,
.ready-day-player .ready-seat-note,
.ready-day-player .day-player-tags {
  position: relative;
  z-index: 6;
}
.ready-day-player.day-player-self .ready-seat-frame {
  background: #85171b;
  border-bottom-color: var(--primary-dark);
}
.room-day-shell .ready-day-player.day-player-self {
  position: relative;
  filter: drop-shadow(0 0 13px rgba(126,17,24,0.32));
}
.room-day-shell .ready-day-player.day-player-self .ready-seat-frame {
  background: #7e1118;
  border-bottom-color: #4a0006;
  box-shadow: 0 0 0 4px #f3c96e, 0 0 0 7px rgba(126,17,24,0.32), 0 20px 34px rgba(74,0,6,0.3);
}
.room-day-shell .ready-day-player.day-player-self .ready-seat-frame:before {
  content: '我';
  position: absolute;
  z-index: 4;
  top: -15px;
  right: -14px;
  width: 29px;
  height: 29px;
  line-height: 27px;
  border: 2px solid #7e1118;
  border-radius: 50%;
  background: #ffdf9a;
  color: #7e1118;
  box-shadow: 0 5px 12px rgba(74,0,6,0.28);
  font-size: 13px;
  font-weight: 900;
  text-align: center;
}
.room-day-shell .ready-day-player.day-player-self .ready-seat-name {
  box-shadow: 0 0 0 2px #f3c96e;
}
.room-day-shell .ready-day-player.day-player-self .ready-seat-note {
  color: #7e1118;
  font-weight: 900;
}
.ready-day-player.day-player-dead {
  opacity: 0.72;
}
.ready-day-player.day-player-dead .ready-seat-frame img {
  filter: grayscale(1);
  opacity: 0.52;
}
.ready-day-player.day-player-dead .ready-seat-frame:after {
  content: '出局';
  position: absolute;
  inset: 7px;
  border-radius: 7px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: rgba(65,0,4,0.62);
  font-size: 16px;
  font-weight: 900;
}
.room-day-shell .ready-day-player.day-player-speaking {
  opacity: 1;
  filter: drop-shadow(0 0 16px rgba(243,201,110,0.52));
}
.room-day-shell .ready-day-player.day-player-speaking .ready-seat-frame {
  box-shadow: 0 0 0 4px #f3c96e, 0 0 0 8px rgba(96,116,49,0.28), 0 20px 34px rgba(74,50,10,0.22);
}
.room-day-shell .ready-day-player.day-player-speaking .ready-seat-name {
  background: #f3c96e;
  color: #4a0006;
  box-shadow: 0 0 0 2px rgba(74,0,6,0.18);
}
.room-day-shell .ready-day-player.day-player-speaking .ready-seat-note {
  color: var(--primary);
  font-weight: 1000;
}
.day-player-tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 4px;
  margin-top: 5px;
  max-width: 130px;
}
.day-player-tags span {
  padding: 2px 6px;
  border-radius: 999px;
  color: var(--primary);
  background: rgba(255,218,215,0.58);
  font-size: 10px;
  font-weight: 900;
  line-height: 1.2;
}
.day-player-tags .wolf {
  color: #fff;
  background: var(--primary);
}
.day-player-tags .good {
  color: #102c17;
  background: #b7ccb9;
}
.ready-center-piece {
  position: absolute;
  z-index: 1;
  left: 50%;
  top: calc(50% - 18px);
  transform: translate(-50%, -50%);
  pointer-events: none;
  width: 190px;
  height: 190px;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #2d4b22;
  background: rgba(231,226,212,0.84);
  border: 5px solid rgba(231,226,212,0.88);
  box-shadow: inset 0 20px 40px rgba(29,28,19,0.08), 0 20px 36px rgba(29,28,19,0.08);
  text-align: center;
}
.ready-center-piece .anticon {
  font-size: 38px;
  margin-bottom: 8px;
}
.ready-center-piece strong {
  color: var(--tertiary);
  font-size: 16px;
}
.ready-center-piece span {
  margin-top: 4px;
  color: #73796e;
  font-size: 12px;
  font-weight: 800;
}
.ready-bottom-actions {
  display: flex;
  gap: 14px;
  padding: 10px;
  border: 4px solid var(--surface-high);
  border-radius: 20px;
  background: rgba(248,243,229,0.94);
  box-shadow: 0 18px 38px rgba(29,28,19,0.12);
}
.ready-bottom-actions button {
  min-width: 96px;
  min-height: 68px;
  border: 0;
  border-bottom: 5px solid #2f1500;
  border-radius: 12px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7px;
  color: var(--tertiary-soft);
  background: var(--tertiary);
  font-family: inherit;
  font-weight: 900;
  cursor: pointer;
}
.ready-bottom-actions button:disabled {
  opacity: 0.46;
  cursor: not-allowed;
}
.ready-bottom-actions button.active,
.ready-bottom-actions button:nth-child(3) {
  background: var(--primary);
  border-bottom-color: var(--primary-dark);
  color: #fff;
}
.day-action-icon {
  width: 24px;
  height: 24px;
  object-fit: contain;
  filter: brightness(0) invert(1);
}
.ready-right-panel {
  grid-column: 3;
  grid-row: 2;
  z-index: 3;
  min-height: 0;
  padding: 30px 30px 30px 0;
  background: var(--surface);
}
.ready-scroll-panel {
  height: 100%;
  min-height: 0;
  position: relative;
  padding: 20px 22px 24px;
  border-left: 8px solid var(--surface-high);
  border-right: 8px solid var(--surface-high);
  border-radius: 14px 14px 0 0;
  display: flex;
  flex-direction: column;
  background: #fef9eb;
  box-shadow: 0 20px 42px rgba(29,28,19,0.14);
  background-image: radial-gradient(#e7e2d4 0.55px, transparent 0.55px);
  background-size: 4px 4px;
}
.scroll-roll {
  height: 14px;
  margin: -28px -18px 22px;
  border-radius: 999px;
  background: var(--surface-high);
  box-shadow: 0 6px 12px rgba(29,28,19,0.08);
}
.ready-scroll-panel h3 {
  margin: 0;
  color: var(--primary);
  font-size: 28px;
  font-style: italic;
  font-weight: 900;
  text-align: center;
}
.panel-subtitle {
  margin: 4px 0 20px;
  color: #73796e;
  font-size: 11px;
  font-weight: 900;
  text-align: center;
}
.waiting-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
  overflow-y: auto;
  min-height: 0;
}
.waiting-player {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px;
  border-radius: 12px;
  background: rgba(248,243,229,0.78);
  border: 1px solid rgba(231,226,212,0.82);
}
.waiting-player img {
  width: 48px;
  height: 48px;
  border-radius: 10px;
  object-fit: cover;
  border: 2px solid var(--tertiary-soft);
}
.waiting-player strong {
  display: block;
  color: var(--primary);
  font-size: 14px;
}
.waiting-player span {
  display: block;
  color: #73796e;
  font-size: 11px;
}
.ready-rule-card {
  margin-top: auto;
  padding: 16px;
  border-left: 3px solid var(--primary);
  border-radius: 4px;
  background: rgba(255,218,215,0.25);
}
.ready-rule-card strong {
  display: block;
  color: var(--primary);
  margin-bottom: 6px;
}
.ready-rule-card span,
.ready-empty-text {
  color: #43483f;
  font-size: 13px;
  line-height: 1.65;
}
.room-day-shell .ready-status-banner h2 {
  letter-spacing: 0.1em;
}
.room-day-shell .ready-main {
  padding-top: 30px;
}
.room-day-shell .ready-orbit {
  margin-top: 18px;
}
.day-speaker-card {
  margin-top: 0;
}
.day-vote-panel {
  margin: 0 0 16px;
  padding: 14px;
  border: 1px solid rgba(96,116,49,0.2);
  border-radius: 8px;
  background: rgba(215,234,171,0.34);
}
.day-vote-countdown {
  text-align: center;
}
.day-vote-countdown span {
  display: block;
  color: #607431;
  font-size: 12px;
  font-weight: 900;
}
.day-vote-countdown strong {
  display: block;
  margin: 4px 0 10px;
  color: var(--primary);
  font-size: 36px;
  line-height: 1.1;
  font-weight: 1000;
}
.day-speech-countdown-panel {
  background: rgba(255,218,215,0.3);
}
.day-speech-turn-text {
  color: #43483f;
  font-size: 13px;
  line-height: 1.55;
  font-weight: 800;
  text-align: center;
}
.day-vote-progress div {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #43483f;
  font-size: 12px;
  font-weight: 900;
}
.day-vote-progress strong {
  color: var(--primary);
}
.day-vote-progress i {
  display: block;
  height: 8px;
  margin-top: 8px;
  border-radius: 999px;
  background: rgba(67,72,63,0.14);
  overflow: hidden;
}
.day-vote-progress b {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: var(--primary);
  transition: width 0.2s ease;
}
.day-vote-roster {
  display: grid;
  gap: 8px;
  max-height: 150px;
  margin-top: 12px;
  overflow-y: auto;
}
.day-vote-roster span {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 7px 9px;
  border-radius: 4px;
  color: #43483f;
  background: rgba(254,249,235,0.7);
  font-size: 12px;
  font-weight: 800;
}
.day-vote-roster span.done {
  color: #607431;
}
.day-vote-roster em {
  flex: 0 0 auto;
  color: inherit;
  font-style: normal;
  font-weight: 900;
}
.vote-result-status {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 10px;
}
.vote-result-status span {
  padding: 4px 8px;
  border-radius: 4px;
  color: #5d261f;
  background: rgba(255,218,215,0.36);
  font-size: 12px;
  font-weight: 800;
}
.day-discussion-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
  overflow-y: auto;
  min-height: 0;
  padding-right: 4px;
}
.day-discussion-item {
  padding: 12px 0 14px;
  border-bottom: 1px solid rgba(231,226,212,0.76);
}
.day-discussion-speaker {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--secondary);
  font-size: 13px;
  font-weight: 900;
  line-height: 1.4;
}
.day-discussion-speaker em {
  min-width: 64px;
  padding: 2px 16px;
  border: 2px solid var(--primary);
  color: var(--primary);
  background: rgba(255,218,215,0.28);
  font-size: 13px;
  font-style: normal;
  font-weight: 900;
  line-height: 1.3;
  text-align: center;
}
.day-discussion-lastwords .day-discussion-text {
  color: #4a1f13;
}
.day-discussion-text {
  margin-top: 6px;
  color: #1d1c13;
  font-size: 14px;
  font-style: italic;
  line-height: 1.65;
}
.room-dusk-shell {
  --surface: #fef9eb;
  --surface-low: #f8f3e5;
  --surface-mid: #f3eee0;
  --surface-high: #e7e2d4;
  --primary: #7a000b;
  --primary-dark: #4a0006;
  --secondary: #5a6a37;
  --secondary-soft: #d7eaab;
  --tertiary: #5b2f00;
  --tertiary-soft: #ffdcc3;
  grid-template-columns: 270px minmax(680px, 1fr) 340px;
  color: #1d1c13;
  background: var(--surface);
}
.dusk-bg {
  position: fixed;
  inset: 76px 340px 0 270px;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
  background: #2f1500;
}
.dusk-bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: saturate(0.9) sepia(0.12);
}
.dusk-bg:before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(47,21,0,0.58), rgba(110,57,0,0.18) 42%, rgba(29,28,19,0.64));
  mix-blend-mode: multiply;
}
.dusk-bg:after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(0deg, rgba(254,249,235,0.92), rgba(254,249,235,0.28) 46%, rgba(254,249,235,0.08));
}
.dusk-topbar {
  grid-column: 1/4;
  background: linear-gradient(180deg, rgba(254,249,235,0.95), rgba(243,238,224,0.9));
}
.dusk-room-plaque {
  background: var(--tertiary);
  border-bottom-color: #2f1500;
}
.dusk-sidebar {
  grid-column: 1;
  background: rgba(248,243,229,0.97);
}
.dusk-sidebar nav button.active {
  color: var(--primary);
  background: rgba(231,226,212,0.84);
  border-left: 4px solid var(--primary);
  border-radius: 4px 12px 12px 4px;
}
.dusk-narrator img {
  object-fit: cover;
  background: #fff;
  border-color: var(--primary);
}
.dusk-narrator .ready-narrator-portrait {
  background: #fff;
  border-color: var(--primary);
}
.dusk-summary strong {
  color: var(--primary);
}
.dusk-main {
  grid-column: 2;
  grid-row: 2;
  z-index: 2;
  padding: 34px 34px 28px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 28px;
}
.dusk-stage-heading {
  text-align: center;
}
.dusk-kicker {
  min-height: 38px;
  display: inline-flex;
  align-items: center;
  gap: 12px;
  padding: 0 26px;
  border: 1px solid rgba(255,151,51,0.28);
  border-radius: 999px;
  color: #ffb14a;
  background: rgba(91,47,0,0.82);
  box-shadow: 0 12px 26px rgba(47,21,0,0.18);
  font-size: 15px;
  font-weight: 900;
  letter-spacing: 0.08em;
}
.dusk-stage-heading h2 {
  margin: 18px 0 8px;
  color: var(--primary);
  font-size: 34px;
  line-height: 1.1;
  font-weight: 900;
  letter-spacing: 0.08em;
}
.dusk-stage-heading p {
  margin: 0 auto;
  max-width: 720px;
  color: #5e241c;
  font-size: 15px;
  line-height: 1.7;
  font-weight: 800;
}
.dusk-grid {
  display: grid;
  grid-template-columns: minmax(300px, 390px) minmax(380px, 1fr);
  gap: 28px;
  align-items: stretch;
}
.dusk-result-panel,
.dusk-vote-panel,
.dusk-action-bar {
  border: 1px solid rgba(115,121,110,0.24);
  border-radius: 8px;
  background: rgba(254,249,235,0.72);
  backdrop-filter: blur(12px);
  box-shadow: 0 24px 40px -18px rgba(29,28,19,0.22);
}
.dusk-result-panel {
  min-height: 380px;
  position: relative;
  overflow: hidden;
  padding: 34px 32px 30px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}
.dusk-result-panel:before,
.dusk-result-panel:after {
  content: '';
  position: absolute;
  width: 52px;
  height: 52px;
  border-color: rgba(122,0,11,0.32);
  border-style: solid;
}
.dusk-result-panel:before {
  top: 0;
  left: 0;
  border-width: 1px 0 0 1px;
}
.dusk-result-panel:after {
  right: 0;
  bottom: 0;
  border-width: 0 1px 1px 0;
}
.dusk-portrait-wrap {
  position: relative;
  margin-bottom: 24px;
}
.dusk-exile-portrait {
  position: relative;
  width: 158px;
  height: 158px;
  padding: 6px;
  border-radius: 8px;
  background: #fffaf0;
  box-shadow: 0 18px 34px rgba(47,21,0,0.24);
}
.dusk-exile-portrait img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 4px;
  filter: grayscale(0.25) contrast(1.08);
}
.dusk-exile-portrait:after {
  content: '';
  position: absolute;
  inset: 6px;
  border-radius: 4px;
  background: rgba(122,0,11,0.34);
}
.dusk-noout-portrait {
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(90,106,55,0.72);
  background: rgba(248,243,229,0.94);
  font-size: 72px;
}
.dusk-noout-portrait:after {
  display: none;
}
.dusk-exile-stamp {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 2;
  transform: translate(-50%, -50%) rotate(-10deg);
  padding: 6px 14px;
  border: 4px solid #d4191f;
  border-radius: 5px;
  color: #d4191f;
  background: rgba(255,255,255,0.92);
  font-size: 30px;
  font-weight: 900;
  line-height: 1;
  letter-spacing: 0.08em;
}
.dusk-exile-number {
  position: absolute;
  left: -16px;
  top: -14px;
  z-index: 3;
  min-width: 50px;
  height: 44px;
  line-height: 40px;
  border: 2px solid rgba(115,121,110,0.34);
  border-radius: 999px;
  color: #111;
  background: #f3eee0;
  box-shadow: 0 8px 14px rgba(29,28,19,0.12);
  font-size: 18px;
  font-weight: 900;
}
.dusk-result-panel h3 {
  margin: 0 0 10px;
  color: #1d1c13;
  font-size: 24px;
  line-height: 1.25;
  font-weight: 900;
}
.dusk-result-panel p {
  margin: 0;
  max-width: 320px;
  color: #43483f;
  font-size: 16px;
  line-height: 1.7;
  font-weight: 800;
}
.dusk-result-tags {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 22px;
}
.dusk-result-tags span {
  padding: 6px 14px;
  border-radius: 999px;
  color: #6b171b;
  background: rgba(255,218,215,0.6);
  font-size: 12px;
  font-weight: 900;
}
.dusk-vote-panel {
  min-height: 380px;
  padding: 26px 28px 20px;
  display: flex;
  flex-direction: column;
}
.dusk-panel-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18px;
  border-bottom: 1px solid rgba(115,121,110,0.18);
}
.dusk-panel-title div {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #1d1c13;
  font-size: 18px;
  font-weight: 900;
}
.dusk-panel-title .anticon {
  color: var(--primary);
}
.dusk-panel-title span {
  padding: 6px 14px;
  border-radius: 999px;
  color: #43483f;
  background: rgba(243,238,224,0.9);
  font-size: 12px;
  font-weight: 900;
}
.dusk-vote-list {
  min-height: 0;
  display: flex;
  flex-direction: column;
  gap: 13px;
  margin-top: 18px;
  overflow-y: auto;
}
.dusk-vote-row {
  position: relative;
  min-height: 74px;
  display: grid;
  grid-template-columns: minmax(190px, 1.1fr) minmax(90px, 1fr) 64px;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  border: 1px solid rgba(115,121,110,0.16);
  border-radius: 8px;
  background: rgba(254,249,235,0.54);
}
.dusk-vote-exiled {
  border-color: rgba(186,26,26,0.28);
  background: rgba(255,218,215,0.28);
}
.dusk-vote-exiled:before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4px;
  background: #ba1a1a;
}
.dusk-vote-person {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}
.dusk-vote-avatar {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  overflow: hidden;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--secondary);
  background: rgba(215,234,171,0.36);
  border: 1px solid rgba(115,121,110,0.22);
  font-size: 22px;
}
.dusk-vote-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.dusk-vote-person strong {
  display: block;
  color: #1d1c13;
  font-size: 15px;
  line-height: 1.3;
  font-weight: 900;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.dusk-vote-person span {
  display: block;
  margin-top: 2px;
  color: #73796e;
  font-size: 11px;
  font-weight: 800;
}
.dusk-vote-marks {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
  color: rgba(67,72,63,0.52);
  font-size: 22px;
  font-weight: 900;
}
.dusk-vote-marks.active {
  color: #ba1a1a;
}
.dusk-vote-marks em {
  font-style: normal;
  font-size: 12px;
}
.dusk-vote-count {
  color: #43483f;
  font-size: 18px;
  font-weight: 900;
  text-align: right;
}
.dusk-vote-exiled .dusk-vote-count {
  color: var(--primary);
  font-size: 22px;
}
.dusk-voters {
  grid-column: 1/4;
  color: #73796e;
  font-size: 11px;
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.dusk-empty-record {
  min-height: 170px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #73796e;
  font-size: 14px;
  font-weight: 800;
  text-align: center;
}
.dusk-vote-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 14px;
  color: #43483f;
  font-size: 12px;
  font-weight: 900;
}
.dusk-action-bar {
  min-height: 104px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 18px 24px;
  background: rgba(248,243,229,0.9);
}
.dusk-action-left {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
}
.dusk-voice-status {
  min-height: 32px;
  display: inline-flex;
  align-items: center;
  padding: 0 10px;
  border-radius: 8px;
  color: #73796e;
  background: rgba(254,249,235,0.72);
  font-size: 12px;
  font-weight: 900;
}
.dusk-voice-status.active {
  color: var(--primary);
  background: rgba(225,234,213,0.92);
}
.dusk-action-bar button {
  min-height: 56px;
  border: 0;
  border-radius: 8px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  padding: 0 20px;
  color: #43483f;
  background: rgba(254,249,235,0.92);
  box-shadow: 0 10px 18px rgba(29,28,19,0.08);
  font-family: inherit;
  font-size: 15px;
  font-weight: 900;
  cursor: pointer;
}
.dusk-action-bar button.active {
  color: #fff;
  background: var(--primary);
}
.dusk-action-bar button:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}
.dusk-next-btn {
  min-width: 190px;
  color: #fff !important;
  background: linear-gradient(135deg, var(--primary), #93000a) !important;
  box-shadow: 0 18px 30px rgba(122,0,11,0.24) !important;
  font-size: 20px !important;
}
.dusk-next-btn span {
  font-size: 24px;
}
.dusk-right-panel {
  grid-column: 3;
  grid-row: 2;
  z-index: 3;
  min-height: 0;
  padding: 30px 30px 30px 0;
  background: rgba(254,249,235,0.92);
}
.dusk-scroll-panel {
  color: #1d1c13;
  background: rgba(254,249,235,0.96);
  background-image: radial-gradient(#e7e2d4 0.55px, transparent 0.55px);
  background-size: 4px 4px;
}
.dusk-scroll-panel h3 {
  color: var(--primary);
}
.dusk-scroll-panel .day-discussion-list {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
}
.dusk-scroll-panel .ready-rule-card {
  flex: 0 0 auto;
}
.room-dusk-shell {
  --surface: #f4eadb;
  --surface-low: #eee2d1;
  --surface-mid: #ded0bd;
  --surface-high: #b99a78;
  --primary: #7e1118;
  --primary-dark: #4a0006;
  --secondary: #5e583d;
  --secondary-soft: #d9c9ad;
  --tertiary: #4d2811;
  --tertiary-soft: #d8b78d;
  color: #241913;
  background: #2d211a;
}
.dusk-topbar {
  background: linear-gradient(180deg, rgba(247,239,226,0.96), rgba(224,210,191,0.92));
  box-shadow: 0 12px 30px rgba(42,26,17,0.18);
}
.dusk-topbar .ready-brand {
  color: #344d32;
  text-shadow: 0 1px 0 rgba(255,250,242,0.7);
}
.dusk-topbar button {
  color: #5e503e;
}
.dusk-room-plaque {
  background: linear-gradient(180deg, #5d2c10, #351807);
  border-bottom-color: #231006;
  box-shadow: 0 14px 28px rgba(35,16,6,0.3);
}
.dusk-room-plaque span {
  color: #d8b78d;
}
.dusk-sidebar {
  background: linear-gradient(180deg, rgba(245,236,221,0.98), rgba(226,211,191,0.96));
  box-shadow: 22px 0 42px rgba(44,27,18,0.13);
}
.dusk-sidebar .ready-narrator strong {
  color: var(--primary);
}
.dusk-sidebar .ready-narrator span,
.dusk-sidebar nav button,
.dusk-sidebar .ready-side-link {
  color: rgba(76,65,50,0.78);
}
.dusk-sidebar nav button.active {
  color: var(--primary);
  background: rgba(214,198,175,0.58);
  border-left-color: var(--primary);
  box-shadow: inset 0 0 0 1px rgba(126,17,24,0.08);
}
.dusk-sidebar nav button:hover,
.dusk-sidebar .ready-side-link:hover {
  color: var(--primary);
  background: rgba(214,198,175,0.38);
}
.dusk-summary {
  background: rgba(248,242,233,0.68);
  border-color: rgba(91,74,54,0.2);
}
.dusk-summary div {
  color: #5d5245;
}
.dusk-summary strong {
  color: var(--primary);
}
.dusk-kicker {
  border-color: rgba(201,162,112,0.34);
  color: #ead2b6;
  background: rgba(71,34,16,0.9);
  box-shadow: 0 12px 26px rgba(49,26,15,0.24);
}
.dusk-stage-heading h2 {
  color: #7e1118;
  text-shadow: 0 1px 0 rgba(245,236,221,0.5);
}
.dusk-stage-heading p {
  color: #4f3328;
}
.dusk-result-panel,
.dusk-vote-panel,
.dusk-action-bar {
  border-color: rgba(86,70,52,0.2);
  background: rgba(235,226,213,0.78);
  box-shadow: 0 24px 40px -18px rgba(38,25,17,0.32);
}
.dusk-result-panel:before,
.dusk-result-panel:after {
  border-color: rgba(126,17,24,0.26);
}
.dusk-exile-portrait {
  background: #f7efe4;
  box-shadow: 0 18px 34px rgba(42,27,18,0.24);
}
.dusk-exile-portrait:after {
  background: rgba(89,43,24,0.22);
}
.dusk-noout-portrait {
  color: rgba(88,81,61,0.72);
  background: rgba(247,239,228,0.94);
}
.dusk-exile-number {
  color: #2f2017;
  background: #e8d6bd;
  border-color: rgba(92,74,54,0.28);
}
.dusk-result-panel h3,
.dusk-panel-title div,
.dusk-vote-person strong {
  color: #241913;
}
.dusk-result-panel p,
.dusk-vote-person span,
.dusk-voters,
.dusk-empty-record,
.dusk-vote-footer {
  color: #5d5245;
}
.dusk-result-tags span {
  color: #7d0d13;
  background: rgba(232,214,189,0.82);
}
.dusk-panel-title {
  border-bottom-color: rgba(86,70,52,0.16);
}
.dusk-panel-title span {
  color: #4d4032;
  background: rgba(247,239,228,0.78);
}
.dusk-vote-row {
  border-color: rgba(86,70,52,0.12);
  background: rgba(247,239,228,0.42);
}
.dusk-vote-exiled {
  border-color: rgba(126,17,24,0.26);
  background: rgba(232,214,189,0.58);
}
.dusk-vote-avatar {
  color: #5e583d;
  background: rgba(218,205,185,0.62);
  border-color: rgba(86,70,52,0.18);
}
.dusk-vote-marks {
  color: rgba(76,65,50,0.46);
}
.dusk-vote-count {
  color: #4d4032;
}
.dusk-action-bar {
  background: rgba(236,225,209,0.9);
}
.dusk-action-bar button {
  color: #4d4032;
  background: rgba(248,242,233,0.88);
  box-shadow: 0 10px 18px rgba(38,25,17,0.1);
}
.dusk-action-bar button.active {
  color: #f8efe5;
  background: #7e1118;
}
.dusk-next-btn {
  background: #7e1118 !important;
  box-shadow: 0 18px 30px rgba(74,0,6,0.22) !important;
}
.dusk-right-panel {
  background: rgba(226,211,191,0.94);
}
.dusk-scroll-panel {
  color: #241913;
  border-left-color: #c2a789;
  border-right-color: #c2a789;
  background: #f5ead8;
  background-image: radial-gradient(rgba(120,98,72,0.18) 0.55px, transparent 0.55px);
}
.dusk-scroll-panel .scroll-roll {
  background: #c2a789;
}
.dusk-scroll-panel h3 {
  color: var(--primary);
}
.dusk-scroll-panel .panel-subtitle {
  color: #6a5c4b;
}
.dusk-scroll-panel .day-discussion-speaker {
  color: #8a1016;
}
.dusk-scroll-panel .day-discussion-text {
  color: #3b2d24;
}
.dusk-scroll-panel .ready-rule-card {
  background: rgba(232,214,189,0.54);
  border-left-color: var(--primary);
}
.dusk-scroll-panel .ready-rule-card strong {
  color: var(--primary);
}
.dusk-scroll-panel .ready-rule-card span {
  color: #514337;
}
.room-settlement-shell .settlement-bg:after {
  background: linear-gradient(0deg, rgba(244,234,219,0.97), rgba(244,234,219,0.5) 48%, rgba(47,33,26,0.12));
}
.settlement-main {
  gap: 22px;
}
.settlement-grid {
  grid-template-columns: minmax(285px, 360px) minmax(420px, 1fr);
  gap: 22px;
}
.settlement-result-panel {
  min-height: 390px;
  padding-top: 28px;
}
.settlement-winner-portrait {
  position: relative;
  width: 158px;
  height: 190px;
  margin-bottom: 22px;
  padding: 6px;
  border-radius: 8px;
  background: #f7efe4;
  box-shadow: 0 18px 34px rgba(42,27,18,0.24);
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(126,17,24,0.5);
  font-size: 58px;
}
.settlement-winner-portrait img {
  width: 100%;
  height: 100%;
  border-radius: 4px;
  object-fit: cover;
  object-position: center 18%;
}
.settlement-victory-stamp {
  position: absolute;
  right: -18px;
  bottom: 18px;
  transform: rotate(-9deg);
  padding: 6px 12px;
  border: 4px solid #7e1118;
  border-radius: 5px;
  color: #7e1118;
  background: rgba(247,239,228,0.95);
  font-size: 25px;
  font-weight: 900;
  line-height: 1;
  letter-spacing: 0.08em;
}
.settlement-roster-panel {
  min-height: 390px;
}
.settlement-roster {
  display: grid;
  grid-template-columns: repeat(2, minmax(190px, 1fr));
  gap: 10px;
  margin-top: 18px;
  min-height: 0;
  overflow-y: auto;
}
.settlement-player {
  min-height: 62px;
  display: grid;
  grid-template-columns: 46px minmax(0, 1fr) auto;
  align-items: center;
  gap: 10px;
  padding: 7px 10px;
  border: 1px solid rgba(86,70,52,0.13);
  border-radius: 8px;
  background: rgba(247,239,228,0.44);
}
.settlement-player.winner {
  border-color: rgba(94,88,61,0.25);
  background: rgba(217,201,173,0.52);
}
.settlement-player.out:not(.winner) {
  opacity: 0.65;
}
.settlement-player img {
  width: 46px;
  height: 46px;
  border-radius: 50%;
  object-fit: cover;
  object-position: center 18%;
}
.settlement-player strong {
  display: block;
  overflow: hidden;
  color: #241913;
  font-size: 13px;
  font-weight: 900;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.settlement-player span {
  display: block;
  margin-top: 3px;
  color: #5d5245;
  font-size: 11px;
  font-weight: 800;
}
.settlement-player em {
  padding: 4px 7px;
  border-radius: 999px;
  color: #675747;
  background: rgba(248,242,233,0.9);
  font-size: 10px;
  font-style: normal;
  font-weight: 900;
}
.settlement-player.winner em {
  color: #7e1118;
  background: rgba(248,242,233,0.96);
}
.settlement-actions {
  min-height: 88px;
}
.settlement-again-btn {
  min-width: 174px;
}
.settlement-wait-owner {
  color: #6a5c4b;
  font-size: 13px;
  font-weight: 900;
}
.settlement-report-meta {
  display: flex;
  flex-direction: column;
  gap: 5px;
  margin-bottom: 14px;
  padding: 12px;
  border-left: 3px solid var(--primary);
  background: rgba(232,214,189,0.42);
  color: #514337;
  font-size: 12px;
  font-weight: 900;
}
.settlement-report-text {
  flex: 1;
  min-height: 100px;
  margin: 0 0 14px;
  padding: 13px;
  overflow-y: auto;
  border: 1px solid rgba(86,70,52,0.12);
  border-radius: 4px;
  color: #3b2d24;
  background: rgba(247,239,228,0.5);
  font-family: Georgia, 'Noto Serif SC', 'Noto Serif', serif;
  font-size: 12px;
  line-height: 1.7;
  white-space: pre-wrap;
}
.room-night-shell {
  --surface: #10140f;
  --surface-low: #151a14;
  --surface-mid: #20261f;
  --surface-high: #2b3229;
  --primary: #6f1115;
  --primary-dark: #3f080b;
  --secondary: #ffdf9a;
  --secondary-soft: #3a3426;
  --tertiary: #d6c7aa;
  --tertiary-soft: #fff2c8;
  color: #ece8dc;
  background: #10140f;
}
.night-bg {
  position: fixed;
  inset: 76px 340px 0 256px;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
  background: radial-gradient(circle at 82% 8%, rgba(255,223,154,0.16), transparent 10%), linear-gradient(90deg, rgba(10,14,11,0.93), rgba(20,28,24,0.72)), url("https://lh3.googleusercontent.com/aida-public/AB6AXuDZskf468f36mW0Yzz4qcBkN84ET84qGiuHuUIYs4DWr3tOSXL_iN95yWVupQWp8CHb7Q7A6LVz7WpglvUtW7a1UvlDl1PMTmxBqutoJ4e5DNtplN9vviTK-7hM1troIQZC5chNdLKIERoB82HLxVIMDaCCALOIpnyi1KdBj_Z9RfCHUIyK7MnWCDUQCKb16fRuto1faxaqjH9PhUAdKf-IsYW8d_rla4XBpZv-td5CbWhbhWczp43NfB8YYKVJBDcAEQoYCZHr5SU");
  background-size: cover;
  background-position: center;
}
.night-bg:after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(0deg, rgba(16,20,15,0.95), rgba(16,20,15,0.42) 42%, rgba(16,20,15,0.7));
}
.night-topbar {
  background: rgba(12,16,12,0.9);
  border-bottom: 1px solid rgba(255,223,154,0.12);
  box-shadow: 0 16px 34px rgba(0,0,0,0.28);
}
.night-topbar .ready-brand,
.night-topbar button {
  color: var(--secondary);
}
.night-room-plaque {
  background: #22251f;
  border-bottom-color: #070807;
}
.night-room-plaque span {
  color: #b5aa8f;
}
.night-sidebar {
  background: rgba(13,17,13,0.96);
  border-right: 1px solid rgba(255,223,154,0.1);
  box-shadow: 22px 0 42px rgba(0,0,0,0.26);
}
.night-sidebar .ready-narrator img {
  background: #252a23;
  border-color: rgba(255,223,154,0.45);
}
.night-sidebar .ready-narrator-portrait {
  background: #252a23;
  border-color: rgba(255,223,154,0.45);
}
.night-sidebar .ready-narrator strong {
  color: var(--secondary);
}
.night-sidebar .ready-narrator span {
  color: #b8b49f;
}
.night-sidebar nav button,
.night-sidebar .ready-side-link {
  color: rgba(236,232,220,0.68);
}
.night-sidebar nav button.active,
.night-sidebar nav button:hover,
.night-sidebar .ready-side-link:hover {
  color: var(--secondary);
  background: rgba(255,223,154,0.1);
}
.night-sidebar .ready-summary {
  background: rgba(255,255,255,0.04);
  border-color: rgba(255,223,154,0.12);
}
.night-sidebar .ready-summary div {
  color: rgba(236,232,220,0.72);
}
.night-sidebar .ready-summary strong {
  color: var(--secondary);
}
.night-main {
  padding: 22px 30px 18px;
}
.night-timer {
  min-width: 170px;
  padding: 22px 26px;
  border-left: 4px solid var(--secondary);
  color: var(--secondary);
  background: rgba(37,41,35,0.92);
  box-shadow: 12px 14px 0 rgba(0,0,0,0.25);
  text-align: center;
}
.night-timer span {
  display: block;
  margin-bottom: 6px;
  font-size: 12px;
  font-weight: 900;
  letter-spacing: 0.18em;
}
.night-timer strong {
  display: block;
  color: #ffc400;
  font-size: 38px;
  line-height: 1;
}
.night-square-card {
  height: 100%;
}
.night-status-banner {
  min-width: 360px;
  max-width: 520px;
  border-color: rgba(255,223,154,0.54);
  background: rgba(37,41,35,0.92);
  box-shadow: 0 18px 36px rgba(0,0,0,0.24);
}
.night-status-banner h2 {
  color: var(--secondary);
  letter-spacing: 0.1em;
}
.night-status-banner p {
  color: rgba(236,232,220,0.74);
}
.night-orbit {
  width: 100%;
  min-height: 500px;
  margin: 10px 0 8px;
}
.night-day-player {
  color: #ece8dc;
  cursor: default;
}
.night-day-player:disabled {
  color: #ece8dc;
}
.night-player-actionable {
  cursor: pointer;
}
.night-player-actionable .night-seat-frame {
  box-shadow: 0 0 0 3px rgba(160,174,144,0.28), 0 18px 32px rgba(0,0,0,0.28);
}
.night-player-actionable:hover .night-seat-frame {
  transform: scale(1.08) rotate(0deg);
}
.night-player-muted {
  opacity: 0.5;
}
.night-day-player.day-player-self .night-seat-frame {
  background: #2e382f;
  border-bottom-color: #121711;
}
.night-player-dead {
  opacity: 0.6;
}
.night-player-selected .night-seat-frame {
  box-shadow: 0 0 0 3px rgba(111,17,21,0.66), 0 18px 32px rgba(0,0,0,0.28);
}
.night-seat-frame {
  background: #253129;
  border: 2px solid rgba(172,184,157,0.34);
  border-bottom: 5px solid #101610;
}
.room-night-shell .night-day-player.day-player-self {
  position: relative;
  filter: drop-shadow(0 0 16px rgba(255,223,154,0.34));
}
.room-night-shell .night-day-player.day-player-self.night-player-muted:not(.night-player-dead) {
  opacity: 1;
}
.room-night-shell .night-day-player.day-player-self .night-seat-frame {
  background: #453825;
  border: 2px solid #ffdf9a;
  border-bottom: 5px solid #b4863a;
  box-shadow: 0 0 0 3px rgba(255,223,154,0.28), 0 0 23px rgba(255,223,154,0.3), 0 20px 34px rgba(0,0,0,0.38);
}
.room-night-shell .night-day-player.day-player-self .night-seat-frame:before {
  content: '我';
  position: absolute;
  z-index: 4;
  top: -15px;
  right: -14px;
  width: 29px;
  height: 29px;
  line-height: 27px;
  border: 2px solid #6f1115;
  border-radius: 50%;
  background: #ffdf9a;
  color: #6f1115;
  box-shadow: 0 5px 13px rgba(0,0,0,0.36);
  font-size: 13px;
  font-weight: 900;
  text-align: center;
}
.room-night-shell .night-day-player.day-player-self .ready-seat-name {
  color: #fff2c8;
  background: #6f1115;
  box-shadow: 0 0 0 2px rgba(255,223,154,0.72);
}
.room-night-shell .night-day-player.day-player-self .ready-seat-note {
  color: #ffdf9a;
  font-weight: 900;
}
.night-seat-frame img {
